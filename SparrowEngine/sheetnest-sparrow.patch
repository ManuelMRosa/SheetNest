+
+    // With --max-iterations the outer loops are cut on a counter rather than on elapsed time, which is
+    // the only non-reproducible input the search has; the same instance and seed then always produce the
+    // same solution. Without it the original wall-clock behaviour is kept.
+    let solution = match args.max_iterations {
+        Some(total) => {
+            let explore = ((total as f32) * DEFAULT_EXPLORE_TIME_RATIO).round() as usize;
