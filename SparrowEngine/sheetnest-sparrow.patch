+            )
+        }
+        None => {
+            let mut terminator = CtrlCTerminator::new();
+            optimize(
+                instance.clone(),
+                rng,
+                &mut svg_exporter,
+                &mut terminator,
+                &config.expl_cfg,
+                &config.cmpr_cfg,
