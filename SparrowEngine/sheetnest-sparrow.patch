+            let mut terminator = IterTerminator::new(vec![explore, compress]);
+            optimize(
+                instance.clone(),
+                rng,
+                &mut svg_exporter,
+                &mut terminator,
+                &config.expl_cfg,
+                &config.cmpr_cfg,
