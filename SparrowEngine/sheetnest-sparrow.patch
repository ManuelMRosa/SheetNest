diff --git a/src/util/iter_terminator.rs b/src/util/iter_terminator.rs
new file mode 100644
index 0000000..bb13111
--- /dev/null
+++ b/src/util/iter_terminator.rs
@@ -0,0 +1,83 @@
+use crate::util::terminator::Terminator;
+use jagua_rs::Instant;
+use log::warn;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::Arc;
+use std::time::Duration;
+
+/// A terminator that stops the search after a fixed number of termination checks instead of after a
+/// wall-clock deadline, so that two runs of the same instance with the same seed produce exactly the
+/// same solution.
+///
+/// The wall clock is the only non-reproducible input the search has: the separator's inner loops are
+/// already bounded by counters (`iter_no_imprv_limit`, `strike_limit`), each worker owns an RNG seeded
+/// deterministically from the master, and the workers' results are merged in index order. Cutting the
+/// outer loops on elapsed time is what makes an identical job land differently on a busy machine, on a
+/// slower machine, or simply on the next run.
+///
+/// The budget is consumed by every `kill()` call, which is one check of an outer loop: the exploration
+/// loop, the compression loop and the separator's strike loop all poll it. That mixes the phases into a
+/// single monotonically decreasing budget, which is exactly what makes it reproducible.
+///
+/// `new_timeout` is how the optimizer announces a phase change; the durations it passes are ignored and
+/// the next phase's iteration budget is taken instead. Ctrl-C still terminates immediately.
+#[derive(Debug)]
+pub struct IterTerminator {
+    /// Per-phase budgets, consumed in the order the optimizer starts the phases (explore, then compress).
+    phase_budgets: Vec<usize>,
+    /// Index of the next budget to hand out on `new_timeout`.
+    next_phase: usize,
+    /// Checks remaining in the current phase.
+    remaining: AtomicUsize,
+    pub ctrlc: Arc<AtomicBool>,
+}
+
+impl IterTerminator {
+    /// `phase_budgets` are the termination checks each phase may spend, in phase order. A phase started
+    /// after the list is exhausted gets no budget and stops immediately.
+    pub fn new(phase_budgets: Vec<usize>) -> Self {
+        let ctrlc = Arc::new(AtomicBool::new(false));
+        let c = ctrlc.clone();
+
+        ctrlc::set_handler(move || {
+            warn!(" terminating...");
+            c.store(true, Ordering::SeqCst);
+        })
+        .expect("Error setting Ctrl-C handler");
+
+        Self {
+            phase_budgets,
+            next_phase: 0,
+            remaining: AtomicUsize::new(0),
+            ctrlc,
+        }
+    }
+}
+
+impl Terminator for IterTerminator {
+    fn kill(&self) -> bool {
+        if self.ctrlc.load(Ordering::SeqCst) {
+            return true;
+        }
+
+        // Saturating decrement: once the budget is spent every further check kills, and the counter can
+        // never wrap back into "budget available".
+        let spent = self
+            .remaining
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |r| Some(r.saturating_sub(1)));
+
+        matches!(spent, Ok(0))
+    }
+
+    fn new_timeout(&mut self, _timeout: Duration) {
+        self.ctrlc.store(false, Ordering::SeqCst);
+        let budget = self.phase_budgets.get(self.next_phase).copied().unwrap_or(0);
+        self.next_phase += 1;
+        self.remaining.store(budget, Ordering::SeqCst);
+    }
+
+    /// There is no deadline — nothing in the optimizer reads this.
+    fn timeout_at(&self) -> Option<Instant> {
+        None
+    }
+}
