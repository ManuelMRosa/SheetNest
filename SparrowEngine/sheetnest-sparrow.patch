             (Duration::from_secs(600).mul_f32(DEFAULT_EXPLORE_TIME_RATIO), Duration::from_secs(600).mul_f32(DEFAULT_COMPRESS_TIME_RATIO))
         },
         _ => bail!("invalid cli pattern (clap should have caught this)"),
@@ -56,8 +59,19 @@ pub fn run() -> Result<()>{
         warn!("[MAIN] early termination enabled!");
     }
     args.apply_config_overrides(&mut config);
+    if args.max_iterations.is_some() {
+        // The compression phase's default decay reads the clock: its shrink step is
+        // `range.0 + (elapsed / time_limit) * range`, so how hard it compresses depends on how busy the
+        // machine was. That is a second, independent source of run-to-run variation from the terminator,
+        // and it only shows up once a run is long enough to reach compression. The failure-based decay
+        // is the deterministic equivalent, so a deterministic budget always implies it.
+        config.cmpr_cfg.shrink_decay = ShrinkDecayStrategy::FailureBased(DEFAULT_FAIL_DECAY_RATIO_CMPR);
+    }
 
-    info!("[MAIN] configured to explore for {}s and compress for {}s", explore_dur.as_secs(), compress_dur.as_secs());
+    match args.max_iterations {
+        Some(n) => info!("[MAIN] deterministic mode: {} termination checks, {} workers", n, config.expl_cfg.separator_config.n_workers),
+        None => info!("[MAIN] configured to explore for {}s and compress for {}s, {} workers", explore_dur.as_secs(), compress_dur.as_secs(), config.expl_cfg.separator_config.n_workers),
+    }
 
     let rng = match config.rng_seed {
         Some(seed) => {
@@ -104,17 +118,37 @@ pub fn run() -> Result<()>{
         )
     };
     
-    let mut ctrlc_terminator = CtrlCTerminator::new();
-
-    let solution = optimize(
-        instance,
-        rng,
-        &mut svg_exporter,
-        &mut ctrlc_terminator,
-        &config.expl_cfg,
-        &config.cmpr_cfg,
-        initial_solution.as_ref()
-    )?;
+    // With --max-iterations the outer loops are cut on a counter rather than on elapsed time, which is
+    // the only non-reproducible input the search has; the same instance and seed then always produce the
+    // same solution. Without it the original wall-clock behaviour is kept.
+    let solution = match args.max_iterations {
+        Some(total) => {
+            let explore = ((total as f32) * DEFAULT_EXPLORE_TIME_RATIO).round() as usize;
+            let compress = total.saturating_sub(explore);
+            let mut terminator = IterTerminator::new(vec![explore, compress]);
+            optimize(
+                instance,
+                rng,
+                &mut svg_exporter,
+                &mut terminator,
+                &config.expl_cfg,
+                &config.cmpr_cfg,
+                initial_solution.as_ref()
+            )?
+        }
+        None => {
+            let mut terminator = CtrlCTerminator::new();
+            optimize(
+                instance,
+                rng,
+                &mut svg_exporter,
+                &mut terminator,
+                &config.expl_cfg,
+                &config.cmpr_cfg,
+                initial_solution.as_ref()
+            )?
+        }
+    };
 
     let json_path = format!("{OUTPUT_DIR}/final_{}.json", ext_instance.name);
     let json_output = ExtSPOutput {
