<Window x:Class="DeepNestSharp.Ui.Views.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SheetNest - Problem Report"
        FontFamily="Tahoma" FontSize="11"
        Width="560" Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" FontSize="13" FontWeight="Bold" Text="SheetNest ran into a problem." />
    <TextBlock Grid.Row="1" Margin="0,6,0,8" TextWrapping="Wrap">
      <Run Text="A crash report was saved to:" />
      <LineBreak />
      <Run x:Name="logPathRun" FontWeight="Bold" />
    </TextBlock>

    <TextBox Grid.Row="2" x:Name="reportBox" IsReadOnly="True" TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="10.5" Background="White" />

    <TextBlock Grid.Row="3" Margin="0,8,0,10" TextWrapping="Wrap" Foreground="#333333"
               Text="Reporting this helps fix it. The button below opens your browser with a pre-filled GitHub issue - you can review everything there, and NOTHING is sent unless you submit it yourself." />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Report on GitHub" FontWeight="Bold" Padding="12,4" Margin="0,0,8,0" Click="OnReport" />
      <Button Content="Copy details" Padding="12,4" Margin="0,0,8,0" Click="OnCopy" />
      <Button Content="Close" Padding="12,4" IsCancel="True" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
