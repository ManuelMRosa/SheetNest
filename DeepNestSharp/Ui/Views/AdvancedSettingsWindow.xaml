<Window x:Class="DeepNestSharp.Ui.Views.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SheetNest.Localization;assembly=SheetNest.Localization"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="{x:Static loc:Strings.Advanced_Title}"
        FontFamily="Tahoma" FontSize="11"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Panel}">
  <!-- Curated settings dialog: ONLY options the live raster engine / export / app actually consume.
       The old auto-generated property grid exposed ~30 retired NFP/GA engine knobs. -->
  <StackPanel Margin="14" Width="380">

    <GroupBox Header="{x:Static loc:Strings.Advanced_NestingGroup}" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.Advanced_DefaultRotations}" VerticalAlignment="Center" Margin="0,0,10,6" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="rotationsCombo" Width="150" HorizontalAlignment="Left" Margin="0,0,0,6"
                  ToolTip="{x:Static loc:Strings.Advanced_DefaultRotationsTip}">
          <ComboBoxItem Tag="1" Content="{x:Static loc:Strings.Rotation_AsDrawn}" />
          <ComboBoxItem Tag="2">0 / 180°</ComboBoxItem>
          <ComboBoxItem Tag="4" Content="{x:Static loc:Strings.Advanced_Rotations90}" />
          <ComboBoxItem Tag="8" Content="{x:Static loc:Strings.Rotation_45Steps}" />
          <ComboBoxItem Tag="36" Content="{x:Static loc:Strings.Rotation_Free}" />
        </ComboBox>

        <TextBlock x:Name="spacingLabel" Grid.Row="1" Grid.Column="0" Text="Part spacing (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="1" Grid.Column="1" x:Name="spacingUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.05" FormatString="0.###"
                           ToolTip="{x:Static loc:Strings.Advanced_PartSpacingTip}" />

        <TextBlock x:Name="marginLabel" Grid.Row="2" Grid.Column="0" Text="Sheet edge margin (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="2" Grid.Column="1" x:Name="marginUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.05" FormatString="0.###"
                           ToolTip="{x:Static loc:Strings.Advanced_SheetEdgeMarginTip}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:Strings.Advanced_NestingEffort}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="effortCombo" Width="150" HorizontalAlignment="Left"
                  ToolTip="{x:Static loc:Strings.Advanced_NestingEffortTip}">
          <ComboBoxItem Tag="0" Content="{x:Static loc:Strings.Main_EffortFast}" />
          <ComboBoxItem Tag="1" Content="{x:Static loc:Strings.Main_EffortNormal}" />
          <ComboBoxItem Tag="2" Content="{x:Static loc:Strings.Main_EffortBest}" />
        </ComboBox>
      </Grid>
    </GroupBox>

    <GroupBox Header="{x:Static loc:Strings.Advanced_CommonLineGroup}" Padding="8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="commonLineGapLabel" Grid.Row="0" Grid.Column="0" Text="Common Line Gap (in):"
                   VerticalAlignment="Center" Margin="0,0,10,6" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
          <xctk:DoubleUpDown x:Name="commonLineGapUpDown" Width="80" HorizontalAlignment="Left"
                             Increment="0.001" FormatString="0.000##"
                             ToolTip="{x:Static loc:Strings.Advanced_CommonLineGapTip}" />
          <Button Style="{StaticResource ModernButton}" Content="{x:Static loc:Strings.Advanced_ResetGap}" Margin="8,0,0,0" Padding="8,2"
                  Click="OnResetCommonLineGap"
                  ToolTip="{x:Static loc:Strings.Advanced_ResetGapTip}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.Advanced_MaxClusterParts}"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <ComboBox x:Name="commonLineClusterModeCombo" Width="70" HorizontalAlignment="Left"
                    SelectionChanged="OnCommonLineClusterModeChanged"
                    ToolTip="{x:Static loc:Strings.Advanced_ClusterModeTip}">
            <ComboBoxItem Tag="auto" Content="{x:Static loc:Strings.Advanced_ClusterAuto}" />
            <ComboBoxItem Tag="manual" Content="{x:Static loc:Strings.Advanced_ClusterManual}" />
          </ComboBox>
          <xctk:IntegerUpDown x:Name="commonLineMaxClusterPartsUpDown" Width="58" Margin="6,0,0,0"
                              Minimum="2" Maximum="500" Increment="1"
                              ToolTip="{x:Static loc:Strings.Advanced_MaxClusterPartsTip}" />
          <Button Style="{StaticResource ModernButton}" Content="{x:Static loc:Strings.Advanced_ResetCluster}" Margin="8,0,0,0" Padding="8,2"
                  Click="OnResetCommonLineMaxClusterParts"
                  ToolTip="{x:Static loc:Strings.Advanced_ResetClusterTip}" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Header="{x:Static loc:Strings.Advanced_DxfExportGroup}" Padding="8" Margin="0,10,0,0">
      <StackPanel>
        <CheckBox x:Name="mergeLinesCheck" Content="{x:Static loc:Strings.Advanced_MergeLines}"
                  ToolTip="{x:Static loc:Strings.Advanced_MergeLinesTip}" />
        <CheckBox x:Name="differentiateCheck" Content="{x:Static loc:Strings.Advanced_DifferentiateHoles}" Margin="0,8,0,0"
                  ToolTip="{x:Static loc:Strings.Advanced_DifferentiateHolesTip}" />
      </StackPanel>
    </GroupBox>

    <GroupBox Header="{x:Static loc:Strings.Advanced_ApplicationGroup}" Padding="8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.Advanced_Units}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="unitsCombo" Width="150" HorizontalAlignment="Left" Margin="0,0,0,8"
                  SelectionChanged="OnUnitsChanged"
                  ToolTip="{x:Static loc:Strings.Advanced_UnitsTip}">
          <ComboBoxItem Tag="in" Content="{x:Static loc:Strings.Advanced_Inches}" />
          <ComboBoxItem Tag="mm" Content="{x:Static loc:Strings.Advanced_Millimeters}" />
        </ComboBox>

        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="autosaveCheck" Margin="0,0,0,8"
                  Content="{x:Static loc:Strings.Advanced_Autosave}"
                  Checked="OnAutosaveToggled" Unchecked="OnAutosaveToggled"
                  ToolTip="{x:Static loc:Strings.Advanced_AutosaveTip}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:Strings.Advanced_AutosaveMinutes}" VerticalAlignment="Center" Margin="18,0,10,0" />
        <xctk:IntegerUpDown Grid.Row="2" Grid.Column="1" x:Name="minutesUpDown" Width="70" HorizontalAlignment="Left"
                            Minimum="1" Maximum="60" Value="5"
                            ToolTip="{x:Static loc:Strings.Advanced_AutosaveMinutesTip}" />
      </Grid>
    </GroupBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="{x:Static loc:Strings.Common_OK}" Width="90" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="{x:Static loc:Strings.Common_Cancel}" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
