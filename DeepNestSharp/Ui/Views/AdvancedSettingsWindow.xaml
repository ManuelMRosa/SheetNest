<Window x:Class="DeepNestSharp.Ui.Views.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Advanced Settings"
        FontFamily="Tahoma" FontSize="11"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Panel}">
  <!-- Curated settings dialog: ONLY options the live raster engine / export / app actually consume.
       The old auto-generated property grid exposed ~30 retired NFP/GA engine knobs. -->
  <StackPanel Margin="14" Width="380">

    <GroupBox Header="Nesting" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default part rotations:" VerticalAlignment="Center" Margin="0,0,10,6" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="rotationsCombo" Width="150" HorizontalAlignment="Left" Margin="0,0,0,6"
                  ToolTip="Rotations the nester may try for parts that have not been edited. Edit Part's per-part setting always wins.">
          <ComboBoxItem Tag="1">As drawn</ComboBoxItem>
          <ComboBoxItem Tag="2">0 / 180°</ComboBoxItem>
          <ComboBoxItem Tag="4">90° steps</ComboBoxItem>
          <ComboBoxItem Tag="8">45° steps</ComboBoxItem>
          <ComboBoxItem Tag="36">Free</ComboBoxItem>
        </ComboBox>

        <TextBlock x:Name="spacingLabel" Grid.Row="1" Grid.Column="0" Text="Part spacing (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="1" Grid.Column="1" x:Name="spacingUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.05" FormatString="0.###"
                           ToolTip="Default gap between ordinary parts (drawing units). Edit Part can override it per part; common-line placements use the separate gap below." />

        <TextBlock x:Name="marginLabel" Grid.Row="2" Grid.Column="0" Text="Sheet edge margin (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="2" Grid.Column="1" x:Name="marginUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.05" FormatString="0.###"
                           ToolTip="Clear border kept between every part and the sheet edge." />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Nesting effort:" VerticalAlignment="Center" Margin="0,0,10,0" />
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="effortCombo" Width="150" HorizontalAlignment="Left"
                  ToolTip="How long the nester searches each sheet. It buys a TIGHTER pack, not more parts on the sheet: the parts that fit are found almost at once, and the rest of the search is spent squeezing them together so the material left over comes back as one usable piece.">
          <ComboBoxItem Tag="0">Fast</ComboBoxItem>
          <ComboBoxItem Tag="1">Normal (default)</ComboBoxItem>
          <ComboBoxItem Tag="2">Best (slowest)</ComboBoxItem>
        </ComboBox>
      </Grid>
    </GroupBox>

    <GroupBox Header="Common Line Cutting" Padding="8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="commonLineGapLabel" Grid.Row="0" Grid.Column="0" Text="Common Line Gap (in):"
                   VerticalAlignment="Center" Margin="0,0,10,6" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
          <xctk:DoubleUpDown x:Name="commonLineGapUpDown" Width="80" HorizontalAlignment="Left"
                             Increment="0.001" FormatString="0.000##"
                             ToolTip="Common-line placements use the configured gap; SheetNest resolves one center cut before DXF export. The value is stored in inches and converted to the selected drawing units for display." />
          <Button Style="{StaticResource ModernButton}" Content="Reset to Default" Margin="8,0,0,0" Padding="8,2"
                  Click="OnResetCommonLineGap"
                  ToolTip="Restore the shipped common-line gap." />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Maximum cluster parts:"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <ComboBox x:Name="commonLineClusterModeCombo" Width="70" HorizontalAlignment="Left"
                    SelectionChanged="OnCommonLineClusterModeChanged"
                    ToolTip="Auto lets SheetNest choose a safe cluster size; Manual applies a hard part-count limit.">
            <ComboBoxItem Tag="auto">Auto</ComboBoxItem>
            <ComboBoxItem Tag="manual">Manual</ComboBoxItem>
          </ComboBox>
          <xctk:IntegerUpDown x:Name="commonLineMaxClusterPartsUpDown" Width="58" Margin="6,0,0,0"
                              Minimum="2" Maximum="500" Increment="1"
                              ToolTip="Hard maximum number of parts in one common-line cluster (2 to 500)." />
          <Button Style="{StaticResource ModernButton}" Content="Reset" Margin="8,0,0,0" Padding="8,2"
                  Click="OnResetCommonLineMaxClusterParts"
                  ToolTip="Restore automatic common-line cluster sizing." />
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Header="DXF export" Padding="8" Margin="0,10,0,0">
      <StackPanel>
        <CheckBox x:Name="mergeLinesCheck" Content="Merge coincident cut lines"
                  ToolTip="Legacy export option for ordinary geometry: combines coincident DXF entities. Common-line output resolves its single center cut independently before export." />
        <CheckBox x:Name="differentiateCheck" Content="Color-differentiate hole contours" Margin="0,8,0,0"
                  ToolTip="Hole (child) contours export in a distinct color so the CAM can treat them separately." />
      </StackPanel>
    </GroupBox>

    <GroupBox Header="Application" Padding="8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Units:" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="unitsCombo" Width="150" HorizontalAlignment="Left" Margin="0,0,0,8"
                  SelectionChanged="OnUnitsChanged"
                  ToolTip="Drawing units for parts, sheets, spacing and margins. Match the units your DXF files are drawn in; the physical common-line gap is converted automatically.">
          <ComboBoxItem Tag="in">Inches</ComboBoxItem>
          <ComboBoxItem Tag="mm">Millimeters</ComboBoxItem>
        </ComboBox>

        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="autosaveCheck" Margin="0,0,0,8"
                  Content="Auto save the open project"
                  Checked="OnAutosaveToggled" Unchecked="OnAutosaveToggled"
                  ToolTip="Periodically snapshots the open project so unsaved work can be recovered after a crash." />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Auto Save Time (min):" VerticalAlignment="Center" Margin="18,0,10,0" />
        <xctk:IntegerUpDown Grid.Row="2" Grid.Column="1" x:Name="minutesUpDown" Width="70" HorizontalAlignment="Left"
                            Minimum="1" Maximum="60" Value="5"
                            ToolTip="How often the open project is automatically saved for recovery." />
      </Grid>
    </GroupBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="OK" Width="90" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
