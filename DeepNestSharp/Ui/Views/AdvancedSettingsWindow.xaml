<Window x:Class="DeepNestSharp.Ui.Views.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Advanced Settings"
        FontFamily="Tahoma" FontSize="11"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Panel}">
  <!-- Curated settings dialog: ONLY options the live raster engine / export / app actually consume.
       The old auto-generated property grid exposed ~30 retired NFP/GA engine knobs. -->
  <StackPanel Margin="14" Width="380">

    <GroupBox Header="Nesting" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default part rotations:" VerticalAlignment="Center" Margin="0,0,10,6" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="rotationsCombo" Width="150" HorizontalAlignment="Left" Margin="0,0,0,6"
                  ToolTip="Rotations the nester may try for parts that have not been edited. Edit Part's per-part setting always wins.">
          <ComboBoxItem Tag="1">As drawn</ComboBoxItem>
          <ComboBoxItem Tag="2">0 / 180°</ComboBoxItem>
          <ComboBoxItem Tag="4">90° steps</ComboBoxItem>
          <ComboBoxItem Tag="8">45° steps</ComboBoxItem>
          <ComboBoxItem Tag="36">Free</ComboBoxItem>
        </ComboBox>

        <TextBlock x:Name="spacingLabel" Grid.Row="1" Grid.Column="0" Text="Part spacing (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="1" Grid.Column="1" x:Name="spacingUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.05" FormatString="0.###"
                           ToolTip="Default gap between parts (drawing units). Edit Part can override it per part; common-line parts touch." />

        <TextBlock x:Name="marginLabel" Grid.Row="2" Grid.Column="0" Text="Sheet edge margin (in):" VerticalAlignment="Center" Margin="0,0,10,0" />
        <xctk:DoubleUpDown Grid.Row="2" Grid.Column="1" x:Name="marginUpDown" Width="80" HorizontalAlignment="Left"
                           Minimum="0" Increment="0.05" FormatString="0.###"
                           ToolTip="Clear border kept between every part and the sheet edge." />
      </Grid>
    </GroupBox>

    <GroupBox Header="Common cutting tolerances" Padding="8" Margin="0,10,0,0">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.8"
                   Text="What counts as a shared edge. These are starting values typical of the trade, not measurements, and they need calibrating against the kerf you measured on the machine. They are NOT taken from any other nesting program." />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Out of parallel by up to (deg):" VerticalAlignment="Center" Margin="0,0,10,6" />
          <xctk:DoubleUpDown Grid.Row="0" Grid.Column="1" x:Name="ccAngleUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                             Minimum="0.001" Maximum="45" Increment="0.05" FormatString="0.####"
                             ToolTip="How far from facing each other two edges may be and still be cut as one." />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Shortest edge worth sharing (kerfs):" VerticalAlignment="Center" Margin="0,0,10,6" />
          <xctk:DoubleUpDown Grid.Row="1" Grid.Column="1" x:Name="ccMinEdgeUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                             Minimum="0" Increment="0.5" FormatString="0.###"
                             ToolTip="Below this an edge is a chamfer, not a seam." />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Gap window (kerfs, min / max):" VerticalAlignment="Center" Margin="0,0,10,6" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
            <xctk:DoubleUpDown x:Name="ccGapMinUpDown" Width="70" Minimum="0" Increment="0.05" FormatString="0.###"
                               ToolTip="Closer than this and the pair is not read as a seam." />
            <xctk:DoubleUpDown x:Name="ccGapMaxUpDown" Width="70" Margin="6,0,0,0" Minimum="0" Increment="0.05" FormatString="0.###"
                               ToolTip="Further than this and the parts are left where the nester put them." />
          </StackPanel>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Must run alongside for (kerfs):" VerticalAlignment="Center" Margin="0,0,10,0" />
          <xctk:DoubleUpDown Grid.Row="3" Grid.Column="1" x:Name="ccOverlapUpDown" Width="80" HorizontalAlignment="Left"
                             Minimum="0" Increment="0.5" FormatString="0.###"
                             ToolTip="How far two edges must share a run. This is what stops a corner touch being treated as a seam." />
        </Grid>
      </StackPanel>
    </GroupBox>

    <GroupBox Header="DXF export" Padding="8" Margin="0,10,0,0">
      <StackPanel>
        <CheckBox x:Name="mergeLinesCheck" Content="Merge coincident cut lines (common-line)"
                  ToolTip="Coincident edges of touching parts export as ONE cut line, so the laser cuts shared edges once. It only has anything to do where parts actually share a cut, which is a job imported from SheetCam; on plain DXF parts nothing ever touches, so this changes nothing either way." />
        <CheckBox x:Name="differentiateCheck" Content="Color-differentiate hole contours" Margin="0,8,0,0"
                  ToolTip="Hole (child) contours export in a distinct color so the CAM can treat them separately." />
      </StackPanel>
    </GroupBox>

    <GroupBox Header="Application" Padding="8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Units:" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="unitsCombo" Width="150" HorizontalAlignment="Left" Margin="0,0,0,8"
                  ToolTip="Drawing units for parts, sheets, spacing and margins. Match the units your DXF files are drawn in.">
          <ComboBoxItem Tag="in">Inches</ComboBoxItem>
          <ComboBoxItem Tag="mm">Millimeters</ComboBoxItem>
        </ComboBox>

        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="autosaveCheck" Margin="0,0,0,8"
                  Content="Auto save the open project"
                  Checked="OnAutosaveToggled" Unchecked="OnAutosaveToggled"
                  ToolTip="Periodically snapshots the open project so unsaved work can be recovered after a crash." />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Auto Save Time (min):" VerticalAlignment="Center" Margin="18,0,10,0" />
        <xctk:IntegerUpDown Grid.Row="2" Grid.Column="1" x:Name="minutesUpDown" Width="70" HorizontalAlignment="Left"
                            Minimum="1" Maximum="60" Value="5"
                            ToolTip="How often the open project is automatically saved for recovery." />
      </Grid>
    </GroupBox>

    <GroupBox Header="SheetCam integration" Padding="8" Margin="0,10,0,0">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="Make SheetCam's Auto Nesting open SheetNest instead of its built-in nester. In SheetCam use &quot;Export to Auto Nesting&quot;; nest here, then &quot;Send to SheetCam&quot;." />
        <TextBlock x:Name="integrationStatus" FontWeight="Bold" Margin="0,0,0,8" Text="Not integrated" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="integrateButton" Style="{StaticResource ModernButton}" Content="Integrate with SheetCam..." Width="170" Margin="0,0,8,0" Click="OnIntegrate" />
          <Button x:Name="restoreButton" Style="{StaticResource ModernButton}" Content="Restore SheetCam's nester" Width="170" Click="OnRestore" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0"
                   Text="SheetCam is a trademark of its owner. SheetNest is an independent project, not affiliated with or endorsed by SheetCam." />
      </StackPanel>
    </GroupBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="OK" Width="90" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
