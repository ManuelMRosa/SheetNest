<Window x:Class="DeepNestSharp.Ui.Views.Import3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Import 3D: unfold options"
        FontFamily="Tahoma" FontSize="11"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="14" Width="360">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10" TextWrapping="Wrap"
               Text="Set the bend-allowance K-factor to match your material/machine, then unfold."
               Foreground="{StaticResource Brush.TextMuted}" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="File" VerticalAlignment="Center" Margin="0,0,10,6" />
    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="fileText" VerticalAlignment="Center" Margin="0,0,0,6"
               TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Parts detected" VerticalAlignment="Center" Margin="0,0,10,6" />
    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="solidsText" VerticalAlignment="Center" Margin="0,0,0,6" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="Thickness" VerticalAlignment="Center" Margin="0,0,10,6" />
    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="thicknessText" VerticalAlignment="Center" Margin="0,0,0,6" />

    <TextBlock Grid.Row="4" Grid.Column="0" Text="K-factor" VerticalAlignment="Center" Margin="0,0,10,6" />
    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
      <xctk:DoubleUpDown x:Name="kFactorUpDown" Width="90" Minimum="0" Maximum="2" Increment="0.05" Value="0.40"
                         ToolTip="Bend-allowance K-factor. Calibrate so the unfolded length matches your real flat (0.3–0.5 typical)." />
      <ComboBox x:Name="standardCombo" Width="70" Margin="8,0,0,0" SelectedIndex="0">
        <ComboBoxItem>ANSI</ComboBoxItem>
        <ComboBoxItem>DIN</ComboBoxItem>
      </ComboBox>
    </StackPanel>

    <TextBlock Grid.Row="5" Grid.Column="0" Text="Units" VerticalAlignment="Center" Margin="0,0,10,6" />
    <CheckBox Grid.Row="5" Grid.Column="1" x:Name="unitCheck" VerticalAlignment="Center" Margin="0,0,0,6"
              Content="Inches (uncheck for millimeters)" IsChecked="True"
              Checked="OnUnitChanged" Unchecked="OnUnitChanged"
              ToolTip="Unit your sheets/drawings use; the unfolded flat is converted to this unit." />

    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="okButton" Style="{StaticResource PrimaryButton}" Content="Unfold &amp; Add" Width="110" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
