<Window x:Class="DeepNestSharp.Ui.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SheetNest.Localization;assembly=SheetNest.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeepNestSharp.Ui.Views"
        mc:Ignorable="d"
        Title="{Binding Title, Mode=OneTime}" FontFamily="Tahoma" FontSize="11" Height="610" Width="800" ResizeMode="NoResize" >
  <Grid>
    <StackPanel Orientation="Vertical">
      <TextBlock TextWrapping="Wrap" Margin="5,5,5,8" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Brush.Accent}" Text="{x:Static loc:Strings.About_Intro}" />
      <StackPanel Orientation="Horizontal">
        <TextBlock TextWrapping="Wrap" Margin="5,0" FontWeight="Bold">
    <Run Text="{x:Static loc:Strings.About_DeepNestSharpPort}" /> (<Hyperlink
        NavigateUri="https://github.com/9swampy/DeepNestSharp"
        RequestNavigate="Hyperlink_RequestNavigate">
        https://github.com/9swampy/DeepNestSharp
    </Hyperlink>) v
        </TextBlock>
        <TextBlock Margin="0" Text="{Binding Version, Mode=OneTime}" />
      </StackPanel>
      <TextBlock TextWrapping="Wrap" Margin="5,0" FontWeight="Bold">
    <Run Text="{x:Static loc:Strings.About_DeepNestPortPort}" /> (<Hyperlink 
        NavigateUri="https://github.com/fel88/DeepNestPort"
        RequestNavigate="Hyperlink_RequestNavigate">
        https://github.com/fel88/DeepNestPort
    </Hyperlink>)
      </TextBlock>
      <TextBlock FontWeight="Bold" TextWrapping="Wrap" Margin="5,0">
<Run Text="{x:Static loc:Strings.About_DeepNestOriginal}" /> (<Hyperlink 
        NavigateUri="https://github.com/Jack000/Deepnest"
        RequestNavigate="Hyperlink_RequestNavigate">
        https://github.com/Jack000/Deepnest
    </Hyperlink>)
      </TextBlock>
      <TextBlock TextWrapping="Wrap" Margin="5,0" FontStyle="Italic" FontWeight="DemiBold" Text="{x:Static loc:Strings.About_GiantsQuote}" />
      <TextBlock TextWrapping="Wrap" Margin="5" Text="{x:Static loc:Strings.About_History1}" />
      <TextBlock TextWrapping="Wrap" Margin="5" Text="{x:Static loc:Strings.About_History2}" />
      <TextBlock TextWrapping="Wrap" Margin="5,0" FontStyle="Italic">
<Hyperlink 
        NavigateUri="https://github.com/fel88/DeepNestPort/issues/12#issuecomment-875273391"
        RequestNavigate="Hyperlink_RequestNavigate">
        <Run Text="{x:Static loc:Strings.About_QuoteBreakAway}" />
    </Hyperlink>
      </TextBlock>
      <TextBlock TextWrapping="Wrap" Margin="5,0" FontStyle="Italic" Text="{x:Static loc:Strings.About_QuoteTryCompatibility}" />
      <TextBlock TextWrapping="Wrap" Margin="5,0" FontStyle="Italic" Text="{x:Static loc:Strings.About_QuoteEntangle}" />
      <TextBlock TextWrapping="Wrap" Margin="5" Text="{x:Static loc:Strings.About_History3}" />
      <TextBlock TextWrapping="Wrap" Margin="5" FontWeight="Bold" Text="{x:Static loc:Strings.About_CompilingMinkowski}" />
      <TextBlock TextWrapping="Wrap" Margin="5" Text="{x:Static loc:Strings.About_MinkowskiIntro}" />
      <TextBlock TextWrapping="Wrap" Margin="5,5,5,0" Text="{x:Static loc:Strings.About_MinkowskiStep1}" />
      <TextBlock TextWrapping="Wrap" Margin="20,0" FontStyle="Italic" Text="{x:Static loc:Strings.About_MinkowskiExample}" />
      <TextBlock TextWrapping="Wrap" Margin="5,0" Text="{x:Static loc:Strings.About_MinkowskiStep2}" />
      <TextBlock TextWrapping="Wrap" Margin="5,0" Text="{x:Static loc:Strings.About_MinkowskiStep3}" />
      <TextBlock TextWrapping="Wrap" Margin="5,5" FontStyle="Italic" Text="{x:Static loc:Strings.About_MinkowskiVisualStudio}" />
      <TextBlock TextWrapping="Wrap" FontWeight="Bold" Margin="5" Text="{x:Static loc:Strings.About_Contributors}" />
      <TextBlock TextWrapping="Wrap" Margin="5,0">
<Run Text="{x:Static loc:Strings.About_DxfImportExport}" /> <Hyperlink 
        NavigateUri="https://github.com/IxMilia/Dxf"
        RequestNavigate="Hyperlink_RequestNavigate">
        https://github.com/IxMilia/Dxf
    </Hyperlink>
      </TextBlock>
      <TextBlock TextWrapping="Wrap" Margin="5,0">
<Hyperlink 
        NavigateUri="https://github.com/kelyamany/DeepNestPort"
        RequestNavigate="Hyperlink_RequestNavigate">
        https://github.com/kelyamany/DeepNestPort
    </Hyperlink> <Run Text="{x:Static loc:Strings.About_PortToNetCore}" />
      </TextBlock>
      <TextBlock TextWrapping="Wrap" Margin="5,0">
<Hyperlink 
        NavigateUri="https://github.com/Daniel-t-1/DeepNestPort"
        RequestNavigate="Hyperlink_RequestNavigate">
        https://github.com/Daniel-t-1/DeepNestPort
    </Hyperlink> <Run Text="{x:Static loc:Strings.About_DxfExport}" />
      </TextBlock>
      <TextBlock TextWrapping="Wrap" Margin="5,0">
<Hyperlink 
        NavigateUri="https://github.com/9swampy/DeepNestPort"
        RequestNavigate="Hyperlink_RequestNavigate">
        https://github.com/9swampy/DeepNestPort
    </Hyperlink> <Run Text="{x:Static loc:Strings.About_SimplificationFeatures}" />
      </TextBlock>
      <TextBlock TextWrapping="Wrap" Margin="5,0">
<Hyperlink 
        NavigateUri="https://github.com/fel88/DeepNestPort"
        RequestNavigate="Hyperlink_RequestNavigate">
        https://github.com/fel88/DeepNestPort
    </Hyperlink> <Run Text="{x:Static loc:Strings.About_WinFormsPort}" />
      </TextBlock>
      <TextBlock TextWrapping="Wrap" Margin="5,0">
<Hyperlink 
        NavigateUri="https://github.com/Jack000/Deepnest"
        RequestNavigate="Hyperlink_RequestNavigate">
        https://github.com/Jack000/Deepnest
    </Hyperlink> <Run Text="{x:Static loc:Strings.About_TheOriginalDeepNest}" />
      </TextBlock>
    </StackPanel>
    <Button Content="{x:Static loc:Strings.Common_OK}" Click="OkClick" IsDefault="True" IsCancel="True" Margin="50,40" Width="100" Height="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
  </Grid>
</Window>
