<Window x:Class="DeepNestSharp.Ui.Views.OffcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SheetNest.Localization;assembly=SheetNest.Localization"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="{x:Static loc:Strings.Offcut_Title}"
        FontFamily="Tahoma" FontSize="11"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Panel}">
  <!-- Dedicated offcut dialog (Radan-style): the remnant position is picked from preview cards
       that use the SAME visual language as the live overlay (green dashed cut lines), instead of
       a blind combo box. The caller (MainWindow) persists the results in SessionState. -->
  <Window.Resources>
    <!-- Card border: highlights navy when its wrapping RadioButton is checked.
         DynamicResource throughout — StaticResource to theme keys crashes at parse time in
         dialogs loaded before the merged theme resolves (known gotcha, crash-20260719 log). -->
    <Style x:Key="OffcutCardBorder" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Padding" Value="5" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="Padding" Value="4" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <StackPanel Margin="14">

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">
    <CheckBox x:Name="enableCheck"
              Content="{x:Static loc:Strings.Offcut_Enable}"
              Checked="OnEnableToggled" Unchecked="OnEnableToggled"
              ToolTip="{x:Static loc:Strings.Offcut_EnableTip}" />

    <StackPanel x:Name="detailsPanel" Margin="0,10,0,0">

      <TextBlock Text="{x:Static loc:Strings.Offcut_RemnantPosition}" FontWeight="Bold" Margin="0,0,0,6" />

      <StackPanel Orientation="Horizontal">

        <RadioButton x:Name="endRadio" GroupName="offcutDir" Margin="0,0,10,0" VerticalContentAlignment="Top"
                     ToolTip="{x:Static loc:Strings.Offcut_EndTip}">
          <Border Style="{StaticResource OffcutCardBorder}">
            <StackPanel>
              <Canvas Width="96" Height="56">
                <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="26" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="34" Canvas.Top="4" Width="20" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="4" Canvas.Top="30" Width="30" Height="20" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="38" Canvas.Top="30" Width="16" Height="20" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="66" Canvas.Top="2" Width="28" Height="52" Fill="#1A2E7D32" />
                <Line X1="62" Y1="2" X2="62" Y2="54" Stroke="#000000" StrokeThickness="2.5" />
              </Canvas>
              <TextBlock Text="{x:Static loc:Strings.Offcut_End}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </RadioButton>

        <RadioButton x:Name="sideRadio" GroupName="offcutDir" Margin="0,0,10,0" VerticalContentAlignment="Top"
                     ToolTip="{x:Static loc:Strings.Offcut_SideTip}">
          <Border Style="{StaticResource OffcutCardBorder}">
            <StackPanel>
              <Canvas Width="96" Height="56">
                <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                <Rectangle Canvas.Left="4" Canvas.Top="32" Width="26" Height="20" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="34" Canvas.Top="32" Width="24" Height="20" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="62" Canvas.Top="32" Width="30" Height="20" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="92" Height="20" Fill="#1A2E7D32" />
                <Line X1="2" Y1="26" X2="94" Y2="26" Stroke="#000000" StrokeThickness="2.5" />
              </Canvas>
              <TextBlock Text="{x:Static loc:Strings.Offcut_Side}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </RadioButton>

        <RadioButton x:Name="bothRadio" GroupName="offcutDir" Margin="0,0,10,0" VerticalContentAlignment="Top"
                     ToolTip="{x:Static loc:Strings.Offcut_BothTip}">
          <Border Style="{StaticResource OffcutCardBorder}">
            <StackPanel>
              <Canvas Width="96" Height="56">
                <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                <Rectangle Canvas.Left="4" Canvas.Top="30" Width="24" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="32" Canvas.Top="30" Width="18" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="62" Canvas.Top="2" Width="32" Height="52" Fill="#1A2E7D32" />
                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="54" Height="16" Fill="#1A2E7D32" />
                <Line X1="58" Y1="2" X2="58" Y2="54" Stroke="#000000" StrokeThickness="2.5" />
                <Line X1="2" Y1="22" X2="58" Y2="22" Stroke="#000000" StrokeThickness="2.5" />
              </Canvas>
              <TextBlock Text="{x:Static loc:Strings.Offcut_Both}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </RadioButton>

        <RadioButton x:Name="autoRadio" GroupName="offcutDir" VerticalContentAlignment="Top"
                     ToolTip="{x:Static loc:Strings.Offcut_AutoTip}">
          <Border Style="{StaticResource OffcutCardBorder}">
            <StackPanel>
              <Canvas Width="96" Height="56">
                <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                <Rectangle Canvas.Left="4" Canvas.Top="30" Width="24" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="32" Canvas.Top="30" Width="18" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Line X1="58" Y1="2" X2="58" Y2="54" Stroke="#000000" StrokeThickness="2.5" />
                <Line X1="2" Y1="22" X2="58" Y2="22" Stroke="#000000" StrokeThickness="2.5" />
                <Border Canvas.Left="62" Canvas.Top="6" Background="{DynamicResource Brush.Accent}" Padding="4,1">
                  <TextBlock Text="AUTO" Foreground="White" FontWeight="Bold" FontSize="9" />
                </Border>
              </Canvas>
              <TextBlock Text="{x:Static loc:Strings.Offcut_Auto}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </RadioButton>

      </StackPanel>

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="spacingLabel" Grid.Row="0" Grid.Column="0" Text="Offcut spacing (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <!-- Four decimals, like the overlap: the default is 0.1969in (5mm exactly), and three would show it
             as 0.197 and then SAVE that on OK - the default would corrode just by opening the window. -->
        <xctk:DoubleUpDown Grid.Row="0" Grid.Column="1" x:Name="spacingUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.05" FormatString="0.####"
                           ToolTip="{x:Static loc:Strings.Offcut_SpacingTip}" />

        <!-- The size a remnant has to come out at to be worth cutting off, stated the way a
             remnant cutoff does. Every one of these is 0 by default and 0 means "no opinion", so an
             existing job keeps cutting exactly the remnants it cut before. -->
        <TextBlock x:Name="minXLabel" Grid.Row="1" Grid.Column="0" Text="Minimum X size (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="1" Grid.Column="1" x:Name="minXUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.5" FormatString="0.###"
                           ToolTip="{x:Static loc:Strings.Offcut_MinXTip}" />

        <TextBlock x:Name="minYLabel" Grid.Row="2" Grid.Column="0" Text="Minimum Y size (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="2" Grid.Column="1" x:Name="minYUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.5" FormatString="0.###"
                           ToolTip="{x:Static loc:Strings.Offcut_MinYTip}" />

        <TextBlock x:Name="maxXLabel" Grid.Row="3" Grid.Column="0" Text="Maximum X size (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="3" Grid.Column="1" x:Name="maxXUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.5" FormatString="0.###"
                           ToolTip="{x:Static loc:Strings.Offcut_MaxXTip}" />

        <TextBlock x:Name="maxYLabel" Grid.Row="4" Grid.Column="0" Text="Maximum Y size (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="4" Grid.Column="1" x:Name="maxYUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.5" FormatString="0.###"
                           ToolTip="{x:Static loc:Strings.Offcut_MaxYTip}" />

        <TextBlock x:Name="edgeOverlapLabel" Grid.Row="5" Grid.Column="0" Text="Edge overlap (in):" VerticalAlignment="Center" Margin="0,0,10,0" />
        <xctk:DoubleUpDown Grid.Row="5" Grid.Column="1" x:Name="edgeOverlapUpDown" Width="80" HorizontalAlignment="Left"
                           Minimum="0" Increment="0.05" FormatString="0.####"
                           ToolTip="{x:Static loc:Strings.Offcut_EdgeOverlapTip}" />
      </Grid>

      <!-- Inside detailsPanel on purpose: it sits next to what it restores, and the panel's IsEnabled
           already follows the enable checkbox, so the button greys out with everything else for free. -->
      <Button x:Name="resetButton" Style="{DynamicResource ModernButton}" Content="{x:Static loc:Strings.Offcut_ResetDefaults}"
              HorizontalAlignment="Right" Margin="0,10,0,0" Padding="10,3" Click="OnResetDefaults"
              ToolTip="{x:Static loc:Strings.Offcut_ResetDefaultsTip}" />

    </StackPanel>
    </StackPanel>

    <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border}" Margin="16,0" />

    <!-- The scrap cuts: lines across the skeleton so it comes off in pieces. Same cards and the same kind of
         numbers as the offcut, with their own tick, so either one can be on without the other. The cards show
         a line stopping short of a part, as the real cut does. -->
    <StackPanel Grid.Column="2">
      <CheckBox x:Name="scrapEnableCheck"
                Content="{x:Static loc:Strings.Scrap_Enable}"
                Checked="OnScrapEnableToggled" Unchecked="OnScrapEnableToggled"
                ToolTip="{x:Static loc:Strings.Scrap_EnableTip}" />

      <StackPanel x:Name="scrapDetailsPanel" Margin="0,10,0,0">

        <TextBlock Text="{x:Static loc:Strings.Scrap_Lines}" FontWeight="Bold" Margin="0,0,0,6" />

        <StackPanel Orientation="Horizontal">

          <RadioButton x:Name="scrapBothRadio" GroupName="scrapType" Margin="0,0,10,0" VerticalContentAlignment="Top"
                       ToolTip="{x:Static loc:Strings.Scrap_BothTip}">
            <Border Style="{StaticResource OffcutCardBorder}">
              <StackPanel>
                <Canvas Width="96" Height="56">
                  <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                  <Rectangle Canvas.Left="8" Canvas.Top="8" Width="16" Height="14" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                  <Rectangle Canvas.Left="24" Canvas.Top="34" Width="16" Height="14" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                  <Rectangle Canvas.Left="70" Canvas.Top="10" Width="16" Height="14" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                  <Line X1="32" Y1="1" X2="32" Y2="31" Stroke="#000000" StrokeThickness="1.5" StrokeDashArray="3,2" />
                  <Line X1="32" Y1="51" X2="32" Y2="55" Stroke="#000000" StrokeThickness="1.5" StrokeDashArray="3,2" />
                  <Line X1="62" Y1="1" X2="62" Y2="55" Stroke="#000000" StrokeThickness="1.5" StrokeDashArray="3,2" />
                  <Line X1="1" Y1="28" X2="95" Y2="28" Stroke="#000000" StrokeThickness="1.5" StrokeDashArray="3,2" />
                </Canvas>
                <TextBlock Text="{x:Static loc:Strings.Scrap_Both}" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </RadioButton>

          <RadioButton x:Name="scrapVerticalRadio" GroupName="scrapType" Margin="0,0,10,0" VerticalContentAlignment="Top"
                       ToolTip="{x:Static loc:Strings.Scrap_VerticalTip}">
            <Border Style="{StaticResource OffcutCardBorder}">
              <StackPanel>
                <Canvas Width="96" Height="56">
                  <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                  <Rectangle Canvas.Left="8" Canvas.Top="8" Width="16" Height="14" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                  <Rectangle Canvas.Left="24" Canvas.Top="34" Width="16" Height="14" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                  <Rectangle Canvas.Left="70" Canvas.Top="10" Width="16" Height="14" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                  <Line X1="32" Y1="1" X2="32" Y2="31" Stroke="#000000" StrokeThickness="1.5" StrokeDashArray="3,2" />
                  <Line X1="32" Y1="51" X2="32" Y2="55" Stroke="#000000" StrokeThickness="1.5" StrokeDashArray="3,2" />
                  <Line X1="62" Y1="1" X2="62" Y2="55" Stroke="#000000" StrokeThickness="1.5" StrokeDashArray="3,2" />
                </Canvas>
                <TextBlock Text="{x:Static loc:Strings.Scrap_Vertical}" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </RadioButton>

          <RadioButton x:Name="scrapHorizontalRadio" GroupName="scrapType" VerticalContentAlignment="Top"
                       ToolTip="{x:Static loc:Strings.Scrap_HorizontalTip}">
            <Border Style="{StaticResource OffcutCardBorder}">
              <StackPanel>
                <Canvas Width="96" Height="56">
                  <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                  <Rectangle Canvas.Left="8" Canvas.Top="8" Width="16" Height="14" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                  <Rectangle Canvas.Left="24" Canvas.Top="34" Width="16" Height="14" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                  <Rectangle Canvas.Left="70" Canvas.Top="10" Width="16" Height="14" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                  <Line X1="1" Y1="28" X2="95" Y2="28" Stroke="#000000" StrokeThickness="1.5" StrokeDashArray="3,2" />
                </Canvas>
                <TextBlock Text="{x:Static loc:Strings.Scrap_Horizontal}" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </RadioButton>

        </StackPanel>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock x:Name="scrapSpacingXLabel" Grid.Row="0" Grid.Column="0" Text="Vertical line spacing (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
          <xctk:DoubleUpDown Grid.Row="0" Grid.Column="1" x:Name="scrapSpacingXUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                             Minimum="0" Increment="1" FormatString="0.###"
                             ToolTip="{x:Static loc:Strings.Scrap_SpacingXTip}" />

          <TextBlock x:Name="scrapSpacingYLabel" Grid.Row="1" Grid.Column="0" Text="Horizontal line spacing (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
          <xctk:DoubleUpDown Grid.Row="1" Grid.Column="1" x:Name="scrapSpacingYUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                             Minimum="0" Increment="1" FormatString="0.###"
                             ToolTip="{x:Static loc:Strings.Scrap_SpacingYTip}" />

          <TextBlock x:Name="scrapPartGapLabel" Grid.Row="2" Grid.Column="0" Text="Gap to the parts (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
          <xctk:DoubleUpDown Grid.Row="2" Grid.Column="1" x:Name="scrapPartGapUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                             Minimum="0" Increment="0.01" FormatString="0.####"
                             ToolTip="{x:Static loc:Strings.Scrap_PartGapTip}" />

          <!-- Four decimals for the same reason as the offcut's: 0.1969 must not come back as 0.197. -->
          <TextBlock x:Name="scrapEdgeOverlapLabel" Grid.Row="3" Grid.Column="0" Text="Edge overlap (in):" VerticalAlignment="Center" Margin="0,0,10,0" />
          <xctk:DoubleUpDown Grid.Row="3" Grid.Column="1" x:Name="scrapEdgeOverlapUpDown" Width="80" HorizontalAlignment="Left"
                             Minimum="0" Increment="0.05" FormatString="0.####"
                             ToolTip="{x:Static loc:Strings.Scrap_EdgeOverlapTip}" />
        </Grid>

        <Button x:Name="scrapResetButton" Style="{DynamicResource ModernButton}" Content="{x:Static loc:Strings.Offcut_ResetDefaults}"
                HorizontalAlignment="Right" Margin="0,10,0,0" Padding="10,3" Click="OnScrapResetDefaults"
                ToolTip="{x:Static loc:Strings.Scrap_ResetDefaultsTip}" />

      </StackPanel>
    </StackPanel>
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{DynamicResource PrimaryButton}" Content="{x:Static loc:Strings.Common_OK}" Width="90" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button Style="{DynamicResource ModernButton}" Content="{x:Static loc:Strings.Common_Cancel}" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
