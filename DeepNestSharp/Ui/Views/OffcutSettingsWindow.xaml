<Window x:Class="DeepNestSharp.Ui.Views.OffcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Offcut"
        FontFamily="Tahoma" FontSize="11"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Panel}">
  <!-- Dedicated offcut dialog (Radan-style): the remnant position is picked from preview cards
       that use the SAME visual language as the live overlay (green dashed cut lines), instead of
       a blind combo box. The caller (MainWindow) persists the results in SessionState. -->
  <Window.Resources>
    <!-- Card border: highlights navy when its wrapping RadioButton is checked.
         DynamicResource throughout — StaticResource to theme keys crashes at parse time in
         dialogs loaded before the merged theme resolves (known gotcha, crash-20260719 log). -->
    <Style x:Key="OffcutCardBorder" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Padding" Value="5" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="Padding" Value="4" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <StackPanel Margin="14">

    <CheckBox x:Name="enableCheck"
              Content="Enable rectangular offcut (pack parts to one end)"
              Checked="OnEnableToggled" Unchecked="OnEnableToggled"
              ToolTip="Packs the last sheet's parts toward one end so the leftover material stays one clean, reusable rectangle. The nest itself is never compromised: same parts, same sheet count — the re-pack is only kept when it frees a usable remnant." />

    <StackPanel x:Name="detailsPanel" Margin="0,10,0,0">

      <TextBlock Text="Remnant position" FontWeight="Bold" Margin="0,0,0,6" />

      <StackPanel Orientation="Horizontal">

        <RadioButton x:Name="endRadio" GroupName="offcutDir" Margin="0,0,10,0" VerticalContentAlignment="Top"
                     ToolTip="A full strip at the end of the sheet's long side — the classic remnant.">
          <Border Style="{StaticResource OffcutCardBorder}">
            <StackPanel>
              <Canvas Width="96" Height="56">
                <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="26" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="34" Canvas.Top="4" Width="20" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="4" Canvas.Top="30" Width="30" Height="20" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="38" Canvas.Top="30" Width="16" Height="20" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="66" Canvas.Top="2" Width="28" Height="52" Fill="#1A2E7D32" />
                <Line X1="62" Y1="2" X2="62" Y2="54" Stroke="#2E7D32" StrokeThickness="1.5" StrokeDashArray="4 3" />
              </Canvas>
              <TextBlock Text="End of sheet" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </RadioButton>

        <RadioButton x:Name="sideRadio" GroupName="offcutDir" Margin="0,0,10,0" VerticalContentAlignment="Top"
                     ToolTip="A full strip along the sheet's short side.">
          <Border Style="{StaticResource OffcutCardBorder}">
            <StackPanel>
              <Canvas Width="96" Height="56">
                <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                <Rectangle Canvas.Left="4" Canvas.Top="32" Width="26" Height="20" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="34" Canvas.Top="32" Width="24" Height="20" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="62" Canvas.Top="32" Width="30" Height="20" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="92" Height="20" Fill="#1A2E7D32" />
                <Line X1="2" Y1="26" X2="94" Y2="26" Stroke="#2E7D32" StrokeThickness="1.5" StrokeDashArray="4 3" />
              </Canvas>
              <TextBlock Text="Side of sheet" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </RadioButton>

        <RadioButton x:Name="bothRadio" GroupName="offcutDir" Margin="0,0,10,0" VerticalContentAlignment="Top"
                     ToolTip="The parts pack into a corner, leaving an L-shaped leftover cut as two rectangles (guillotine cuts — no cut ever splits a remnant in two).">
          <Border Style="{StaticResource OffcutCardBorder}">
            <StackPanel>
              <Canvas Width="96" Height="56">
                <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                <Rectangle Canvas.Left="4" Canvas.Top="30" Width="24" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="32" Canvas.Top="30" Width="18" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="62" Canvas.Top="2" Width="32" Height="52" Fill="#1A2E7D32" />
                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="54" Height="16" Fill="#1A2E7D32" />
                <Line X1="58" Y1="2" X2="58" Y2="54" Stroke="#2E7D32" StrokeThickness="1.5" StrokeDashArray="4 3" />
                <Line X1="2" Y1="22" X2="58" Y2="22" Stroke="#2E7D32" StrokeThickness="1.5" StrokeDashArray="4 3" />
              </Canvas>
              <TextBlock Text="Both (L-shaped)" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </RadioButton>

        <RadioButton x:Name="autoRadio" GroupName="offcutDir" VerticalContentAlignment="Top"
                     ToolTip="The nest tries End, Side and Both and keeps whichever leaves the largest reusable remnant.">
          <Border Style="{StaticResource OffcutCardBorder}">
            <StackPanel>
              <Canvas Width="96" Height="56">
                <Rectangle Width="96" Height="56" Stroke="#888888" StrokeThickness="1" Fill="#FAFAFA" />
                <Rectangle Canvas.Left="4" Canvas.Top="30" Width="24" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Rectangle Canvas.Left="32" Canvas.Top="30" Width="18" Height="22" Fill="#B4B8BC" Stroke="#808080" StrokeThickness="0.5" />
                <Line X1="58" Y1="2" X2="58" Y2="54" Stroke="#2E7D32" StrokeThickness="1.5" StrokeDashArray="4 3" />
                <Line X1="2" Y1="22" X2="58" Y2="22" Stroke="#2E7D32" StrokeThickness="1.5" StrokeDashArray="4 3" />
                <Border Canvas.Left="62" Canvas.Top="6" Background="{DynamicResource Brush.Accent}" Padding="4,1">
                  <TextBlock Text="AUTO" Foreground="White" FontWeight="Bold" FontSize="9" />
                </Border>
              </Canvas>
              <TextBlock Text="Auto (best remnant)" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </RadioButton>

      </StackPanel>

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="spacingLabel" Grid.Row="0" Grid.Column="0" Text="Offcut spacing (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="0" Grid.Column="1" x:Name="spacingUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.05" FormatString="0.###"
                           ToolTip="Gap kept between the packed parts and the offcut cut line (drawing units)." />

        <TextBlock x:Name="minWidthLabel" Grid.Row="1" Grid.Column="0" Text="Minimum remnant width (in):" VerticalAlignment="Center" Margin="0,0,10,0" />
        <xctk:DoubleUpDown Grid.Row="1" Grid.Column="1" x:Name="minWidthUpDown" Width="80" HorizontalAlignment="Left"
                           Minimum="0" Increment="0.05" FormatString="0.###"
                           ToolTip="Narrowest strip worth separating (drawing units). Below this the sheet is left uncut. 0 = automatic (5% of the sheet's side)." />
      </Grid>

    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{DynamicResource PrimaryButton}" Content="OK" Width="90" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button Style="{DynamicResource ModernButton}" Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
