<Window x:Class="DeepNestSharp.Ui.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Application Settings"
        FontFamily="Tahoma" FontSize="11"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="14" Width="320">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- SigmaNEST-style autosave options: an enable toggle and "Auto Save Time (min)". -->
    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="autosaveCheck" Margin="0,0,0,8"
              Content="Auto save the open project" IsChecked="True"
              Checked="OnAutosaveToggled" Unchecked="OnAutosaveToggled"
              ToolTip="Periodically snapshots the open project so unsaved work can be recovered after a crash." />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Auto Save Time (min)" VerticalAlignment="Center" Margin="18,0,10,0" />
    <xctk:IntegerUpDown Grid.Row="1" Grid.Column="1" x:Name="minutesUpDown" Width="70" HorizontalAlignment="Left"
                        Minimum="1" Maximum="60" Value="5"
                        ToolTip="How often the open project is automatically saved for recovery." />

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="OK" Width="90" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
