<Window x:Class="DeepNestSharp.Ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:userControls="clr-namespace:DeepNestSharp.Ui.UserControls"
        xmlns:converters="clr-namespace:DeepNestSharp.Ui.Converters"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:placement="clr-namespace:DeepNestLib.Placement;assembly=DeepNestLib.Core"
        xmlns:nestproject="clr-namespace:DeepNestLib.NestProject;assembly=DeepNestLib.Core"
        mc:Ignorable="d"
        Title="{Binding Title}" Icon="/Branding/sheetnest-icon.png"
        Height="850" Width="1340" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:PartPreviewConverter x:Key="PartPreview" />
    <ObjectDataProvider x:Key="PlacementTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="placement:PlacementTypeEnum" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="StrictAngleValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="nestproject:AnglesEnum" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <Style x:Key="SettingLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,6,10,6" />
    </Style>
    <Style x:Key="RibbonButton" TargetType="Button">
      <Setter Property="Margin" Value="3,2" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="StatusValue" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="4,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatusLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#555" />
      <Setter Property="Margin" Value="12,0,2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Menu bar with SheetNest logo -->
    <DockPanel Grid.Row="0" Background="#FAFAFA">
      <Image DockPanel.Dock="Right" Source="/Branding/sheetnest-logo.png" Height="30"
             Margin="0,2,12,2" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
      <Menu Background="Transparent" VerticalAlignment="Center">
      <MenuItem Header="_File">
        <MenuItem Header="New Project" Command="{Binding CreateNestProjectCommand}" />
        <MenuItem Header="Open Project..." Command="{Binding LoadNestProjectCommand}" />
        <Separator />
        <MenuItem Header="Save" Command="{Binding ActiveDocumentSaveCommand}" />
        <MenuItem Header="Save As..." Command="{Binding ActiveDocumentSaveAsCommand}" />
        <Separator />
        <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About" Command="{Binding AboutDialogCommand}" />
      </MenuItem>
    </Menu>
    </DockPanel>

    <!-- Ribbon -->
    <TabControl Grid.Row="1" Background="#F3F3F3" Height="92">
      <TabItem Header="Home">
        <StackPanel Orientation="Horizontal">
          <GroupBox Header="Project" Margin="4,2">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource RibbonButton}" Content="New" Command="{Binding CreateNestProjectCommand}" ToolTip="Start a new nesting project" />
              <Button Style="{StaticResource RibbonButton}" Content="Open" Command="{Binding LoadNestProjectCommand}" ToolTip="Open an existing project" />
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Input" Margin="4,2">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource RibbonButton}" Content="Add Part" Click="OnAddPartClicked" ToolTip="Load a part from DXF/SVG" />
              <Button Style="{StaticResource RibbonButton}" Content="Add Sheet" Command="{Binding ActiveDocument.AddSheetCommand}" ToolTip="Add a stock sheet size" />
              <Button Style="{StaticResource RibbonButton}" Content="Clear Parts" Command="{Binding ActiveDocument.ClearPartsCommand}" ToolTip="Remove all parts" />
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </TabItem>
      <TabItem Header="Nest">
        <StackPanel Orientation="Horizontal">
          <GroupBox Header="Run" Margin="4,2">
            <StackPanel Orientation="Horizontal">
              <Button Content="&#9654;  NEST" Click="OnNest"
                      Margin="3,2" Padding="18,6" MinWidth="110" FontWeight="Bold" FontSize="15"
                      Background="#2E7D32" Foreground="White"
                      ToolTip="Run the nest." />
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </TabItem>
      <TabItem Header="Output">
        <StackPanel Orientation="Horizontal">
          <GroupBox Header="Export" Margin="4,2">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource RibbonButton}" Content="Export DXF" Click="OnExportDxf" ToolTip="Export the selected nest result to DXF" />
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- Main work area -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="360" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <!-- Center: faithful DXF nest viewer + results strip -->
      <Grid Grid.Column="0" Margin="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1">
          <userControls:DxfViewer x:Name="dxfViewer" Result="{Binding NestMonitorViewModel.SelectedItem}"
                                  SheetIndex="0" />
        </Border>
        <Grid Grid.Row="1" Margin="0,4,0,0" DataContext="{Binding NestMonitorViewModel}">
          <Grid.RowDefinitions>
            <RowDefinition Height="150" />
          </Grid.RowDefinitions>
          <ListView Grid.Row="0"
                    ItemsSource="{Binding TopNestResults}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="% Util." Width="70">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding MaterialUtilization, StringFormat={}{0:P1}}" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2E7D32" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Placed" Width="60" DisplayMemberBinding="{Binding TotalPlacedCount, Mode=OneWay}" />
                <GridViewColumn Header="Unplaced" Width="65" DisplayMemberBinding="{Binding TotalUnplacedCount, Mode=OneWay}" />
                <GridViewColumn Header="Sheets" Width="55" DisplayMemberBinding="{Binding UsedSheets.Count, Mode=OneWay}" />
                <GridViewColumn Header="Fitness" Width="75" DisplayMemberBinding="{Binding Fitness, StringFormat=0.0000, Mode=OneWay}" />
                <GridViewColumn Header="Time" Width="75" DisplayMemberBinding="{Binding CreatedAt, StringFormat=HH:mm:ss, Mode=OneWay}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#EEE" />

      <!-- Right: Parts / Sheets / Settings -->
      <TabControl Grid.Column="2" Margin="0,4,4,4">
        <TabItem Header="Parts">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="+ Add Part" Click="OnAddPartClicked" Margin="4" Padding="6,4" />
            <ListView x:Name="partsListView" ItemsSource="{Binding ActiveDocument.ProjectInfo.DetailLoadInfos}"
                      SelectedItem="{Binding ActiveDocument.SelectedDetailLoadInfo}"
                      MouseDoubleClick="OnPartsListDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="46" Height="46" Background="White" BorderBrush="#D5D5D5" BorderThickness="1" Margin="0,0,8,0">
                      <Image Source="{Binding Converter={StaticResource PartPreview}}" Stretch="Uniform" Margin="3" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                      <TextBlock Text="{Binding NetArea, Mode=OneWay, StringFormat='{}{0:0} area'}" FontSize="10" Foreground="#888" />
                    </StackPanel>
                    <xctk:IntegerUpDown Grid.Column="2" Minimum="0" Width="50" VerticalAlignment="Center" Margin="4,0"
                                        Value="{Binding Quantity, Mode=TwoWay}" ToolTip="Quantity (required — spares are set in Edit Part)" />
                    <Button Grid.Column="3" Content="&#9998;" VerticalAlignment="Center" Padding="7,2" Margin="2,0,0,0"
                            ToolTip="Edit part (quantity, orientations, priority)"
                            Click="OnEditPart" Tag="{Binding}" />
                    <Button Grid.Column="4" Content="&#10005;" VerticalAlignment="Center" Padding="7,2" Margin="2,0,0,0"
                            ToolTip="Remove part"
                            Command="{Binding DataContext.ActiveDocument.RemovePartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </DockPanel>
        </TabItem>
        <TabItem Header="Sheets">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="+ Add Sheet" Command="{Binding ActiveDocument.AddSheetCommand}" Margin="4" Padding="6,4" />
            <DockPanel DockPanel.Dock="Top" Margin="4,4,4,2">
              <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox x:Name="sheetPresetCombo" DisplayMemberPath="Name" SelectionChanged="OnSheetPresetSelected"
                        ToolTip="Apply a standard stock size to the selected sheet." />
            </DockPanel>
            <ListView x:Name="sheetsListView" ItemsSource="{Binding ActiveDocument.ProjectInfo.SheetLoadInfos}"
                      SelectedItem="{Binding ActiveDocument.SelectedSheetLoadInfo}">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Width" Width="90">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <xctk:IntegerUpDown Minimum="0" Width="80" Value="{Binding Width, Mode=TwoWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Height" Width="90">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <xctk:IntegerUpDown Minimum="0" Width="80" Value="{Binding Height, Mode=TwoWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Qty" Width="60">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <xctk:IntegerUpDown Minimum="0" Width="50" Value="{Binding Quantity, Mode=TwoWay}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="" Width="60">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Remove"
                                Command="{Binding DataContext.ActiveDocument.RemoveSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>
        <TabItem Header="Settings">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" DataContext="{Binding SvgNestConfigViewModel}">
              <TextBlock Text="Nesting settings" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Part spacing, rotation and common-line are set PER PART in the Edit Part dialog
                     (pencil button / double-click a part). -->

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingLabel}" Text="Sheet edge margin" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                  <xctk:DoubleUpDown Width="100" Minimum="0" Increment="0.5"
                                     Value="{Binding SvgNestConfig.SheetSpacing}"
                                     ToolTip="Empty border kept clear around the sheet (in the drawing's units)." />
                </StackPanel>

              </Grid>

              <Expander Header="Advanced (all settings)" Margin="0,16,0,0" IsExpanded="False">
                <Border BorderBrush="#DDD" BorderThickness="1" Margin="0,6,0,0">
                  <userControls:SvgNestConfigEditor MinHeight="300" />
                </Border>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="#ECECEC" BorderBrush="#CCC" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Height="28">
        <TextBlock Style="{StaticResource StatusLabel}" Text="Utilization:" />
        <TextBlock Style="{StaticResource StatusValue}" Foreground="#2E7D32" FontSize="14"
                   Text="{Binding NestMonitorViewModel.SelectedItem.MaterialUtilization, StringFormat={}{0:P1}, FallbackValue=--}" />
        <TextBlock Style="{StaticResource StatusLabel}" Text="Sheets:" />
        <TextBlock Style="{StaticResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.UsedSheets.Count, FallbackValue=--}" />
        <TextBlock Style="{StaticResource StatusLabel}" Text="Placed:" />
        <TextBlock Style="{StaticResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.TotalPlacedCount, FallbackValue=--}" />
        <TextBlock Style="{StaticResource StatusLabel}" Text="Unplaced:" />
        <TextBlock Style="{StaticResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.TotalUnplacedCount, FallbackValue=--}" />
        <TextBlock Style="{StaticResource StatusLabel}" Text="Running:" />
        <TextBlock Style="{StaticResource StatusValue}" Text="{Binding NestMonitorViewModel.IsRunning}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
