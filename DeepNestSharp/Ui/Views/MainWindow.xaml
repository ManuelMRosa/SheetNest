<Window x:Class="DeepNestSharp.Ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SheetNest.Localization;assembly=SheetNest.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:userControls="clr-namespace:DeepNestSharp.Ui.UserControls"
        xmlns:converters="clr-namespace:DeepNestSharp.Ui.Converters"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:placement="clr-namespace:DeepNestLib.Placement;assembly=DeepNestLib.Core"
        xmlns:nestproject="clr-namespace:DeepNestLib.NestProject;assembly=DeepNestLib.Core"
        mc:Ignorable="d"
        Title="{Binding Title}" Icon="/Branding/sheetnest-icon.png"
        FontFamily="Tahoma" FontSize="11"
        Height="850" Width="1340" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:PartPreviewConverter x:Key="PartPreview" />
    <converters:RgbToBrushConverter x:Key="RgbToBrush" />

    <!-- The drawing units every size on the cards is written in. ApplyUnits swaps it for "mm". -->
    <sys:String x:Key="UnitsLabel">in</sys:String>

    <!-- A colour swatch is the colour and nothing else. The default button template paints a background,
         a raised border and padding around its content, which framed every colour in a white box. -->
    <Style x:Key="ColourSwatchButton" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="content" />
            <ControlTemplate.Triggers>
              <!-- Nothing is raised any more, so the hover cue has to come from the colour itself. -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="content" Property="Opacity" Value="0.75" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ObjectDataProvider x:Key="PlacementTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="placement:PlacementTypeEnum" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="StrictAngleValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="nestproject:AnglesEnum" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Menu bar (branding lives in the title-bar icon only). -->
    <DockPanel Grid.Row="0" Background="{DynamicResource Brush.Window}">
      <Menu Background="Transparent" VerticalAlignment="Center">
      <MenuItem Header="{x:Static loc:Strings.Menu_File}">
        <MenuItem Header="{x:Static loc:Strings.Menu_NewProject}" Command="{Binding CreateNestProjectCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_OpenProject}" Command="{Binding LoadNestProjectCommand}" />
        <MenuItem x:Name="recentProjectsMenu" Header="{x:Static loc:Strings.Menu_RecentProjects}" SubmenuOpened="OnRecentProjectsOpened">
          <MenuItem Header="{x:Static loc:Strings.Menu_RecentEmpty}" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="{x:Static loc:Strings.Menu_Import3D}" Click="OnImport3DClicked" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_Save}" Command="{Binding ActiveDocumentSaveCommand}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_SaveAs}" Command="{Binding ActiveDocumentSaveAsCommand}" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Menu_Exit}" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem x:Name="settingsMenu" Header="{x:Static loc:Strings.Menu_Settings}">
        <MenuItem Header="{x:Static loc:Strings.Menu_Offcut}" Click="OnOffcutSettings" />
        <MenuItem Header="{x:Static loc:Strings.Menu_AdvancedSettings}" Click="OnAdvancedSettings" />
      </MenuItem>
      <MenuItem Header="{x:Static loc:Strings.Menu_Help}">
        <MenuItem Header="{x:Static loc:Strings.Menu_CheckUpdates}" Click="OnCheckUpdates" />
        <MenuItem Header="{x:Static loc:Strings.Menu_SendFeedback}" Click="OnSendFeedback" ToolTip="{x:Static loc:Strings.Menu_SendFeedbackTip}" />
        <MenuItem Header="{x:Static loc:Strings.Menu_About}" Command="{Binding AboutDialogCommand}" />
      </MenuItem>
    </Menu>
    </DockPanel>

    <!-- Single toolbar: everything one click away — no tab switching for the primary flow. -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{DynamicResource ModernButton}" Margin="3,0" Content="{x:Static loc:Strings.Main_Export}" Click="OnExportDxf" ToolTip="{x:Static loc:Strings.Main_ExportTip}" />
          <Button Style="{DynamicResource ModernButton}" Margin="3,0" Content="{x:Static loc:Strings.Main_NestReport}" Click="OnNestReportPdf" ToolTip="{x:Static loc:Strings.Main_NestReportTip}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Style="{DynamicResource ModernButton}" Margin="3,0" Content="{x:Static loc:Strings.Main_New}" Command="{Binding CreateNestProjectCommand}" ToolTip="{x:Static loc:Strings.Main_NewTip}" />
          <Button Style="{DynamicResource ModernButton}" Margin="3,0" Content="{x:Static loc:Strings.Main_Open}" Command="{Binding LoadNestProjectCommand}" ToolTip="{x:Static loc:Strings.Main_OpenTip}" />
          <Rectangle Style="{DynamicResource ToolbarSeparator}" />
          <!-- Split button: NEST runs the job, the arrow beside it picks how hard to search. Effort is a
               per-job decision (it decides whether the last part of a row gets to share its cut), so it
               belongs next to the button that starts the job, not only inside Advanced Settings. -->
          <Button Style="{DynamicResource PrimaryButton}" Margin="3,0,0,0" MinWidth="130" Content="{x:Static loc:Strings.Main_Nest}" Click="OnNest" ToolTip="{x:Static loc:Strings.Main_NestTip}" />
          <Button x:Name="nestEffortButton" Style="{DynamicResource PrimaryButton}" Margin="0,0,3,0"
                  MinWidth="22" Padding="6,4" Content="&#9662;" Click="OnNestEffortMenu">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="effortFastItem" Header="{x:Static loc:Strings.Main_EffortFast}" IsCheckable="True" Tag="0" Click="OnNestEffortChosen" />
                <MenuItem x:Name="effortNormalItem" Header="{x:Static loc:Strings.Main_EffortNormal}" IsCheckable="True" Tag="1" Click="OnNestEffortChosen" />
                <MenuItem x:Name="effortBestItem" Header="{x:Static loc:Strings.Main_EffortBest}" IsCheckable="True" Tag="2" Click="OnNestEffortChosen" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="cancelNestButton" Style="{DynamicResource DangerButton}" Margin="3,0" MinWidth="130" Content="{x:Static loc:Strings.Main_Cancel}" Click="OnCancelNest" Visibility="Collapsed" ToolTip="{x:Static loc:Strings.Main_CancelTip}" />
          <Button Style="{DynamicResource DangerButton}" Margin="3,0" MinWidth="130" Content="{x:Static loc:Strings.Main_ClearResult}" Click="OnClearResult" ToolTip="{x:Static loc:Strings.Main_ClearResultTip}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main work area: the viewer with the job's parts and stock in a bar under it, and the nests of the
         result in a column that runs beside both. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="300" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="200" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="200" MinHeight="110" />
        </Grid.RowDefinitions>

        <!-- Faithful DXF nest viewer. Which nest it shows is picked in the Nests panel. (The old results
             grid below it was removed: the raster engine returns a single result, so the row only
             duplicated the status bar readouts.) -->
        <Border Grid.Row="0" Margin="4,4,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
          <userControls:DxfViewer x:Name="dxfViewer" Result="{Binding NestMonitorViewModel.SelectedItem}" />
        </Border>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource Brush.BorderSubtle}" />

        <!-- Bottom bar: Parts / Sheets / Clearances -->
        <TabControl Grid.Row="2" Margin="4,0,0,4">
          <TabItem Header="{x:Static loc:Strings.Main_PartsTab}">
            <!-- A nest result owns the current stock/part counts: lock editing until Clear Result. -->
            <DockPanel>
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="IsEnabled" Value="False" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding NestMonitorViewModel.SelectedItem}" Value="{x:Null}">
                      <Setter Property="IsEnabled" Value="True" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <!-- Toolbar over the list: its buttons act on the selected part, and without a selection there is
                   nothing for them to act on. 3D import lives in File > Import 3D (STEP / IGES)..., not
                   frequent enough for a permanent button. -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,2">
                <Button Style="{DynamicResource ModernButton}" Content="{x:Static loc:Strings.Main_AddPart}" Click="OnAddPartClicked"
                        ToolTip="{x:Static loc:Strings.Main_AddPartTip}" />
                <!-- Disabled as a group, not per button: the buttons take the theme's style as a DynamicResource
                     because this window is built before the application loads its theme, and a style cannot be
                     BasedOn a DynamicResource. A StaticResource here stops the app from starting. -->
                <StackPanel Orientation="Horizontal">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem, ElementName=partsListView}" Value="{x:Null}">
                          <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Button Style="{DynamicResource ModernButton}" Margin="4,0,0,0" Content="{x:Static loc:Strings.Common_Edit}" Click="OnEditPart"
                          Tag="{Binding ActiveDocument.SelectedDetailLoadInfo}"
                          ToolTip="{x:Static loc:Strings.Main_EditPartTip}" />
                  <Button Style="{DynamicResource ModernButton}" Margin="4,0,0,0" Content="{x:Static loc:Strings.Common_Remove}"
                          Command="{Binding ActiveDocument.RemovePartCommand}"
                          CommandParameter="{Binding ActiveDocument.SelectedDetailLoadInfo}"
                          ToolTip="{x:Static loc:Strings.Main_RemovePartTip}" />
                  <Button Style="{DynamicResource ModernButton}" Margin="4,0,0,0" Content="{x:Static loc:Strings.Main_Color}" Click="OnPartColorClick"
                          Tag="{Binding ActiveDocument.SelectedDetailLoadInfo}"
                          ToolTip="{x:Static loc:Strings.Main_ColorTip}" />
                </StackPanel>
              </StackPanel>
              <ListView x:Name="partsListView" ItemsSource="{Binding ActiveDocument.ProjectInfo.DetailLoadInfos}"
                        SelectedItem="{Binding ActiveDocument.SelectedDetailLoadInfo}"
                        MouseDoubleClick="OnPartsListDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <!-- One part, compact: its outline, drawn the way the printed report draws parts, then the
                         counts the job is checked against. The square is the colour the part has in the nest.
                         Quantity itself lives in the Edit Part dialog (Edit / double-click). -->
                    <Grid Width="190" Margin="1">
                      <Grid.ToolTip>
                        <TextBlock>
                          <Run Text="{Binding Path, Mode=OneWay}" /><LineBreak />
                          <Run Text="{Binding NestingLabel, Mode=OneWay}" /><LineBreak />
                          <Run Text="{Binding NetArea, Mode=OneWay, StringFormat={x:Static loc:Strings.Main_NetAreaFormat}}" />
                        </TextBlock>
                      </Grid.ToolTip>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Image Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top" Stretch="Uniform"
                             Source="{Binding PreviewSource, Converter={StaticResource PartPreview}, ConverterParameter=Outline}" />
                      <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"
                                  BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                  Background="{Binding EffectiveColorRgb, Converter={StaticResource RgbToBrush}}" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding RequiredCount, Mode=OneWay, StringFormat={x:Static loc:Strings.Main_RequiredFormat}}" />
                        <TextBlock Text="{Binding NestedCount, Mode=OneWay, StringFormat={x:Static loc:Strings.Main_NestedFormat}}" />
                        <TextBlock Text="{Binding RemainingCount, Mode=OneWay, StringFormat={x:Static loc:Strings.Main_RemainingFormat}}" />
                        <TextBlock TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding SizeLabel, Mode=OneWay, StringFormat={x:Static loc:Strings.Main_SizeFormat}}" /> <Run Text="{DynamicResource UnitsLabel}" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </DockPanel>
          </TabItem>
          <TabItem Header="{x:Static loc:Strings.Main_SheetsTab}">
            <!-- Same lock as the Parts tab: the result's deduction must stay in sync with this list. -->
            <DockPanel>
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="IsEnabled" Value="False" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding NestMonitorViewModel.SelectedItem}" Value="{x:Null}">
                      <Setter Property="IsEnabled" Value="True" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <!-- Toolbar over the list: Edit and Remove act on the selected sheet, so they wait for one. They are
                   disabled as a group for the same reason as the Parts toolbar. -->
              <DockPanel DockPanel.Dock="Top" Margin="4,4,4,2">
                <Button Style="{DynamicResource ModernButton}" Content="{x:Static loc:Strings.Main_AddSheet}" Click="OnAddSheetMenu"
                        ToolTip="{x:Static loc:Strings.Main_AddSheetTip}" />
                <StackPanel Orientation="Horizontal">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem, ElementName=sheetsListView}" Value="{x:Null}">
                          <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Button Style="{DynamicResource ModernButton}" Margin="4,0,0,0" Content="{x:Static loc:Strings.Common_Edit}" Click="OnEditSheet"
                          Tag="{Binding ActiveDocument.SelectedSheetLoadInfo}"
                          ToolTip="{x:Static loc:Strings.Main_EditSheetTip}" />
                  <Button Style="{DynamicResource ModernButton}" Margin="4,0,0,0" Content="{x:Static loc:Strings.Common_Remove}"
                          Command="{Binding ActiveDocument.RemoveSheetCommand}"
                          CommandParameter="{Binding ActiveDocument.SelectedSheetLoadInfo}"
                          ToolTip="{x:Static loc:Strings.Main_RemoveSheetTip}" />
                </StackPanel>
                <TextBlock Style="{DynamicResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Text="{x:Static loc:Strings.Main_SheetsHint}" />
              </DockPanel>
              <ListView x:Name="sheetsListView" ItemsSource="{Binding ActiveDocument.ProjectInfo.SheetLoadInfos}"
                        SelectedItem="{Binding ActiveDocument.SelectedSheetLoadInfo}"
                        MouseDoubleClick="OnSheetsListDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <!-- One stock size, compact: the size, then how many there are, how many the nest used and
                         how many are left. Size and quantity are BOTH edited through the Edit sheet dialog (Edit or
                         double-click). -->
                    <StackPanel Width="150" Margin="1"
                                ToolTip="{x:Static loc:Strings.Main_SheetCardTip}">
                      <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding Width, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Height, Mode=OneWay}" /> <Run Text="{DynamicResource UnitsLabel}" />
                      </TextBlock>
                      <TextBlock x:Name="quantityLine" Text="{Binding TotalCount, Mode=OneWay, StringFormat={x:Static loc:Strings.Main_QuantityFormat}}" />
                      <TextBlock Text="{Binding NestedCount, Mode=OneWay, StringFormat={x:Static loc:Strings.Main_UsedFormat}}" />
                      <TextBlock x:Name="availableLine" Text="{Binding Quantity, Mode=OneWay, StringFormat={x:Static loc:Strings.Main_AvailableFormat}}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <!-- An unlimited size never runs down, so it has no stock level to show: it says so, and
                           Used still reports what the nest took. -->
                      <DataTrigger Binding="{Binding Unlimited}" Value="True">
                        <Setter TargetName="quantityLine" Property="Text" Value="{x:Static loc:Strings.Main_QuantityUnlimited}" />
                        <Setter TargetName="availableLine" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </DockPanel>
          </TabItem>
          <TabItem Header="{x:Static loc:Strings.Main_Clearances}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12" DataContext="{Binding SvgNestConfigViewModel}">
                <TextBlock Text="{x:Static loc:Strings.Main_Clearances}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <!-- Part spacing, rotation and common-line are set PER PART in the Edit Part dialog
                       (pencil button / double-click a part). For 3D (STEP/IGES) parts the K-factor,
                       thickness and unit also live in that dialog — per part, editable, re-unfolds on change. -->

                  <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource SettingLabel}" Text="{x:Static loc:Strings.Main_SheetEdgeMargin}" />
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <xctk:DoubleUpDown x:Name="sheetEdgeMarginBox" Width="100" Minimum="0" Increment="0.5"
                                       Value="{Binding SvgNestConfig.SheetSpacing}"
                                       ToolTip="{x:Static loc:Strings.Main_SheetEdgeMarginTip}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource Brush.BorderSubtle}" />

      <!-- Right: the nests of the result, one entry per distinct layout, drawn in outline like the printed
           report. Picking one puts that layout in the viewer, and the entry on screen stays selected. Entries
           wrap, so a panel widened past two of them shows two columns. -->
      <TabControl Grid.Column="2" Margin="0,4,4,4">
        <TabItem Header="{x:Static loc:Strings.Main_NestsTab}">
          <Grid>
            <ListBox x:Name="nestsList" BorderThickness="0" SelectionChanged="OnNestsListSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Width="230" Margin="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="90" Height="60" Stretch="Uniform" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Sheets, StringFormat={x:Static loc:Strings.Main_SheetsFormat}}" />
                      <TextBlock Text="{Binding Utilization, StringFormat={x:Static loc:Strings.Main_UtilizationFormat}}" />
                      <TextBlock Text="{Binding Size, StringFormat={x:Static loc:Strings.Main_SizeFormat}}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="nestsEmptyHint" Style="{DynamicResource CaptionText}" Margin="8" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
                       Text="{x:Static loc:Strings.Main_NestsEmpty}" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="{DynamicResource Brush.StatusBar}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Height="28">
        <TextBlock Style="{DynamicResource StatusLabel}" Text="{x:Static loc:Strings.Main_StatusUtilization}" />
        <TextBlock Style="{DynamicResource StatusValue}" Foreground="{DynamicResource Brush.Accent}" FontSize="14"
                   Text="{Binding NestMonitorViewModel.SelectedItem.MaterialUtilization, StringFormat={}{0:P1}, FallbackValue=--}" />
        <TextBlock Style="{DynamicResource StatusLabel}" Text="{x:Static loc:Strings.Main_StatusSheets}" />
        <TextBlock Style="{DynamicResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.UsedSheets.Count, FallbackValue=--}" />
        <TextBlock Style="{DynamicResource StatusLabel}" Text="{x:Static loc:Strings.Main_StatusPlaced}" />
        <TextBlock Style="{DynamicResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.TotalPlacedCount, FallbackValue=--}" />
        <TextBlock Style="{DynamicResource StatusLabel}" Text="{x:Static loc:Strings.Main_StatusUnplaced}" />
        <TextBlock Style="{DynamicResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.TotalUnplacedCount, FallbackValue=--}" />
        <!-- Live nest status: elapsed time only, visible while a nest runs and the final time after it ends. -->
        <TextBlock x:Name="nestPhaseText" Style="{DynamicResource StatusValue}" Visibility="Collapsed" Margin="18,0,6,0" />
        <!-- Startup update check lights this up; click opens the GitHub release page. -->
        <TextBlock x:Name="updateNotice" Style="{DynamicResource StatusValue}" Visibility="Collapsed"
                   Cursor="Hand" TextDecorations="Underline" Margin="18,0,0,0"
                   MouseLeftButtonUp="OnUpdateNoticeClick"
                   ToolTip="{x:Static loc:Strings.Main_UpdateNoticeTip}" />
      </StackPanel>
    </Border>

    <!-- Part colour picker. One popup for the whole list, moved onto whichever card's swatch was clicked.
         Built here rather than with the toolkit's ColorPicker: that control's Advanced tab does not switch,
         so its colour canvas was unreachable. This uses the same canvas directly, with no tabs in the way. -->
    <!-- Opens ABOVE the swatch, i.e. INTO the window. The part cards sit in the bar along the bottom, so
         anchoring below the swatch would push the picker past the window's bottom edge - and a Popup is a
         top-level window, so WPF only keeps it on the SCREEN, never inside its parent. -->
    <Popup x:Name="partColorPopup" StaysOpen="False" AllowsTransparency="True"
           Placement="Top" VerticalOffset="-4" PopupAnimation="Fade">
      <Border Background="#C0C0C0" BorderBrush="#404040" BorderThickness="1" Padding="6">
        <StackPanel>
          <TextBlock Text="{x:Static loc:Strings.Main_PartColour}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ItemsControl x:Name="partColorSwatches">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="2" Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{DynamicResource ColourSwatchButton}" Width="34" Height="26" Margin="2"
                        Click="OnPartColorSwatchClick" Tag="{Binding Rgb}" ToolTip="{Binding Label}">
                  <Border Width="34" Height="26" Background="{Binding Brush}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Separator Margin="0,6" />
          <xctk:ColorCanvas x:Name="partColorCanvas" UsingAlphaChannel="False" Width="230"
                            SelectedColorChanged="OnPartColorCanvasChanged" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
