<Window x:Class="DeepNestSharp.Ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:userControls="clr-namespace:DeepNestSharp.Ui.UserControls"
        xmlns:converters="clr-namespace:DeepNestSharp.Ui.Converters"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:placement="clr-namespace:DeepNestLib.Placement;assembly=DeepNestLib.Core"
        xmlns:nestproject="clr-namespace:DeepNestLib.NestProject;assembly=DeepNestLib.Core"
        mc:Ignorable="d"
        Title="{Binding Title}" Icon="/Branding/sheetnest-icon.png"
        FontFamily="Tahoma" FontSize="11"
        Height="850" Width="1340" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:PartPreviewConverter x:Key="PartPreview" />
    <converters:RgbToBrushConverter x:Key="RgbToBrush" />

    <!-- A colour swatch is the colour and nothing else. The default button template paints a background,
         a raised border and padding around its content, which framed every colour in a white box. -->
    <Style x:Key="ColourSwatchButton" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="content" />
            <ControlTemplate.Triggers>
              <!-- Nothing is raised any more, so the hover cue has to come from the colour itself. -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="content" Property="Opacity" Value="0.75" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ObjectDataProvider x:Key="PlacementTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="placement:PlacementTypeEnum" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="StrictAngleValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="nestproject:AnglesEnum" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Menu bar (branding lives in the title-bar icon only). -->
    <DockPanel Grid.Row="0" Background="{DynamicResource Brush.Window}">
      <Menu Background="Transparent" VerticalAlignment="Center">
      <MenuItem Header="_File" SubmenuOpened="OnFileMenuOpened">
        <MenuItem Header="New Project" Command="{Binding CreateNestProjectCommand}" />
        <MenuItem Header="Open Project..." Command="{Binding LoadNestProjectCommand}" />
        <MenuItem x:Name="recentProjectsMenu" Header="Recent Projects" SubmenuOpened="OnRecentProjectsOpened">
          <MenuItem Header="(empty)" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="Import 3D (STEP / IGES)..." Click="OnImport3DClicked" />
        <Separator x:Name="importExportNestSeparator" />
        <MenuItem x:Name="importNestMenu" Header="Import SheetCam Nest..." Click="OnImportNestClicked" />
        <MenuItem x:Name="exportNestMenu" Header="Export SheetCam Nest..." Click="OnExportNestClicked" />
        <Separator />
        <MenuItem Header="Save" Command="{Binding ActiveDocumentSaveCommand}" />
        <MenuItem Header="Save As..." Command="{Binding ActiveDocumentSaveAsCommand}" />
        <Separator />
        <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Settings">
        <MenuItem Header="Offcut..." Click="OnOffcutSettings" />
        <MenuItem Header="Advanced Settings..." Click="OnAdvancedSettings" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for Updates..." Click="OnCheckUpdates" />
        <MenuItem Header="Send Feedback..." Click="OnSendFeedback" ToolTip="Open a pre-filled GitHub issue to suggest ideas or report problems" />
        <MenuItem Header="About" Command="{Binding AboutDialogCommand}" />
      </MenuItem>
    </Menu>
    </DockPanel>

    <!-- Single toolbar: everything one click away — no tab switching for the primary flow. -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="sendToSheetCamButton" Style="{DynamicResource ModernButton}" Margin="3,0" Content="Send to SheetCam"
                  Click="OnSendToSheetCamClicked" Visibility="Collapsed"
                  ToolTip="Write the nested result back to the SheetCam job and close" />
          <Button Style="{DynamicResource ModernButton}" Margin="3,0" Content="Export DXF" Click="OnExportDxf" ToolTip="Export the selected nest result to DXF" />
          <Button Style="{DynamicResource ModernButton}" Margin="3,0" Content="Report PDF" Click="OnNestReportPdf" ToolTip="Save a PDF nest report: cutting plan, layouts, quantities and utilization" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Style="{DynamicResource ModernButton}" Margin="3,0" Content="New" Command="{Binding CreateNestProjectCommand}" ToolTip="Start a new nesting project" />
          <Button Style="{DynamicResource ModernButton}" Margin="3,0" Content="Open" Command="{Binding LoadNestProjectCommand}" ToolTip="Open an existing project" />
          <Rectangle Style="{DynamicResource ToolbarSeparator}" />
          <Button Style="{DynamicResource PrimaryButton}" Margin="3,0" MinWidth="130" Content="&#9654;  NEST" Click="OnNest" ToolTip="Run the nest." />
          <Button x:Name="cancelNestButton" Style="{DynamicResource DangerButton}" Margin="3,0" MinWidth="130" Content="&#9632;  Cancel" Click="OnCancelNest" Visibility="Collapsed" ToolTip="Stop the running nest" />
          <Button Style="{DynamicResource DangerButton}" Margin="3,0" MinWidth="130" Content="Clear Result" Click="OnClearResult" ToolTip="Discard the nest result and return the sheets it used to the stock" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main work area -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="360" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <!-- Center: faithful DXF nest viewer. (The old results grid below it was removed: the raster
           engine returns a single result, so the row only duplicated the status bar readouts.) -->
      <Border Grid.Column="0" Margin="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <userControls:DxfViewer x:Name="dxfViewer" Result="{Binding NestMonitorViewModel.SelectedItem}"
                                SheetIndex="0" />
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource Brush.BorderSubtle}" />

      <!-- Right: Parts / Sheets / Settings -->
      <TabControl Grid.Column="2" Margin="0,4,4,4">
        <TabItem Header="Parts">
          <!-- A nest result owns the current stock/part counts: lock editing until Clear Result. -->
          <DockPanel>
            <DockPanel.Style>
              <Style TargetType="DockPanel">
                <Setter Property="IsEnabled" Value="False" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding NestMonitorViewModel.SelectedItem}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="True" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DockPanel.Style>
            <StackPanel DockPanel.Dock="Bottom">
              <!-- 3D import lives in File > Import 3D (STEP / IGES)... — not frequent enough for a permanent button. -->
              <Button Style="{DynamicResource ModernButton}" Content="+ Add Part" Click="OnAddPartClicked" Margin="4" HorizontalAlignment="Stretch"
                      ToolTip="Add a part to nest (DXF)." />
            </StackPanel>
            <ListView x:Name="partsListView" ItemsSource="{Binding ActiveDocument.ProjectInfo.DetailLoadInfos}"
                      SelectedItem="{Binding ActiveDocument.SelectedDetailLoadInfo}"
                      MouseDoubleClick="OnPartsListDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate>
                  <!-- Industrial part row: preview · name + settings caption · Available badge · actions.
                       Quantity itself lives in the Edit Part dialog (✎ / double-click). -->
                  <Border Margin="4,3" Padding="6" CornerRadius="0"
                          Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <Border.ToolTip>
                      <TextBlock>
                        <Run Text="{Binding Path, Mode=OneWay}" /><LineBreak />
                        <Run Text="{Binding SizeLabel, Mode=OneWay, StringFormat='size {0} in'}" /><LineBreak />
                        <Run Text="{Binding NetArea, Mode=OneWay, StringFormat='net area {0:0.0} in²'}" />
                      </TextBlock>
                    </Border.ToolTip>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Width="48" Height="48" Background="{DynamicResource Brush.Card}"
                              BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" Margin="0,0,8,0">
                        <Image Source="{Binding PreviewSource, Converter={StaticResource PartPreview}}" Stretch="Uniform" Margin="3" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding NestingLabel, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                      </StackPanel>
                      <!-- Always-visible availability: copies left to nest / requested. -->
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0"
                                  ToolTip="Parts still to nest / requested (quantity + spares + mirrored)">
                        <TextBlock Style="{DynamicResource CaptionText}" Text="Available" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,1" />
                        <Border Style="{DynamicResource CountBadge}">
                          <TextBlock Style="{DynamicResource CountBadgeText}" Text="{Binding NestedInfo, Mode=OneWay}" />
                        </Border>
                      </StackPanel>
                      <!-- The colour this part is drawn in: the swatch IS the button — no arrow, no text,
                           just the colour it currently has. Clicking it opens the picker. -->
                      <Button Grid.Column="3" Style="{DynamicResource ColourSwatchButton}"
                              Width="24" Height="22" VerticalAlignment="Center" Margin="4,0,0,0"
                              ToolTip="Colour this part is drawn in"
                              Click="OnPartColorClick" Tag="{Binding}">
                        <!-- A size of its own: an empty Border asks for nothing and would vanish. -->
                        <Border Width="24" Height="22"
                                Background="{Binding EffectiveColorRgb, Converter={StaticResource RgbToBrush}}" />
                      </Button>
                      <Button Grid.Column="4" Style="{DynamicResource IconButton}" Content="&#9998;" VerticalAlignment="Center" Margin="2,0,0,0"
                              ToolTip="Edit part (quantity, orientations, priority)"
                              Click="OnEditPart" Tag="{Binding}" />
                      <Button Grid.Column="5" Style="{DynamicResource IconButton}" Content="&#10005;" VerticalAlignment="Center" Margin="2,0,0,0"
                              ToolTip="Remove part"
                              Command="{Binding DataContext.ActiveDocument.RemovePartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </DockPanel>
        </TabItem>
        <TabItem Header="Sheets">
          <!-- Same lock as the Parts tab: the result's deduction must stay in sync with this list. -->
          <DockPanel>
            <DockPanel.Style>
              <Style TargetType="DockPanel">
                <Setter Property="IsEnabled" Value="False" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding NestMonitorViewModel.SelectedItem}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="True" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DockPanel.Style>
            <Button DockPanel.Dock="Bottom" Style="{DynamicResource ModernButton}" Content="+ Add Sheet" Click="OnAddSheetMenu" Margin="4" HorizontalAlignment="Stretch"
                    ToolTip="Add a stock sheet: pick a standard size or enter a custom one" />
            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource CaptionText}" Margin="4,4,4,6"
                       Text="width = long side · every listed sheet participates; the nester picks the size that wastes least" TextWrapping="Wrap" />
            <!-- Industrial stock list: clean text rows ("120 × 60 · Available 31/31 · ✎ ✕"); size and
                 quantity are BOTH edited through the Edit sheet dialog (✎ or double-click). -->
            <ListView x:Name="sheetsListView" ItemsSource="{Binding ActiveDocument.ProjectInfo.SheetLoadInfos}"
                      SelectedItem="{Binding ActiveDocument.SelectedSheetLoadInfo}"
                      MouseDoubleClick="OnSheetsListDoubleClick">
              <ListView.Resources>
                <!-- Scoped to THIS ListView only (safe — never app-wide implicit styles). -->
                <Style TargetType="GridViewColumnHeader">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                  <Setter Property="BorderThickness" Value="0,0,0,1" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Padding" Value="6,3" />
                  <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
              </ListView.Resources>
              <ListView.View>
                <GridView>
                  <GridViewColumn x:Name="sheetSizeColumn" Header="Sheet (in)" Width="120">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="4,4"
                                   ToolTip="Sheet size, width × height (width = the long side) — edit with ✎ or double-click">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} × {1}">
                              <Binding Path="Width" Mode="OneWay" />
                              <Binding Path="Height" Mode="OneWay" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Available" Width="80">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <!-- Always visible "Quantity Available": sheets of this size
                             still available / total (31/31 before a nest; 3/31 after one used 28). -->
                        <Border Style="{DynamicResource CountBadge}"
                                ToolTip="Sheets of this size still available / total">
                          <TextBlock Style="{DynamicResource CountBadgeText}" Text="{Binding NestedInfo, Mode=OneWay}" />
                        </Border>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="" Width="66">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Button Style="{DynamicResource IconButton}" Content="&#9998;" ToolTip="Edit sheet (size and quantity)"
                                  Click="OnEditSheet" Tag="{Binding}" />
                          <Button Style="{DynamicResource IconButton}" Content="&#10005;" Margin="2,0,0,0" ToolTip="Remove sheet"
                                  Command="{Binding DataContext.ActiveDocument.RemoveSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>
        <TabItem Header="Clearances">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" DataContext="{Binding SvgNestConfigViewModel}">
              <TextBlock Text="Clearances" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Part spacing, rotation and common-line are set PER PART in the Edit Part dialog
                     (pencil button / double-click a part). For 3D (STEP/IGES) parts the K-factor,
                     thickness and unit also live in that dialog — per part, editable, re-unfolds on change. -->

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource SettingLabel}" Text="Sheet edge margin" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                  <xctk:DoubleUpDown x:Name="sheetEdgeMarginBox" Width="100" Minimum="0" Increment="0.5"
                                     Value="{Binding SvgNestConfig.SheetSpacing}"
                                     ToolTip="Empty border kept clear around the sheet (in the drawing's units)." />
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="{DynamicResource Brush.StatusBar}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Height="28">
        <TextBlock Style="{DynamicResource StatusLabel}" Text="Utilization:" />
        <TextBlock Style="{DynamicResource StatusValue}" Foreground="{DynamicResource Brush.Accent}" FontSize="14"
                   Text="{Binding NestMonitorViewModel.SelectedItem.MaterialUtilization, StringFormat={}{0:P1}, FallbackValue=--}" />
        <TextBlock Style="{DynamicResource StatusLabel}" Text="Sheets:" />
        <TextBlock Style="{DynamicResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.UsedSheets.Count, FallbackValue=--}" />
        <TextBlock Style="{DynamicResource StatusLabel}" Text="Placed:" />
        <TextBlock Style="{DynamicResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.TotalPlacedCount, FallbackValue=--}" />
        <TextBlock Style="{DynamicResource StatusLabel}" Text="Unplaced:" />
        <TextBlock Style="{DynamicResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.TotalUnplacedCount, FallbackValue=--}" />
        <!-- Live nest status: elapsed time only, visible while a nest runs and the final time after it ends. -->
        <TextBlock x:Name="nestPhaseText" Style="{DynamicResource StatusValue}" Visibility="Collapsed" Margin="18,0,6,0" />
        <!-- Startup update check lights this up; click opens the GitHub release page. -->
        <TextBlock x:Name="updateNotice" Style="{DynamicResource StatusValue}" Visibility="Collapsed"
                   Cursor="Hand" TextDecorations="Underline" Margin="18,0,0,0"
                   MouseLeftButtonUp="OnUpdateNoticeClick"
                   ToolTip="A newer SheetNest is available — click to open the download page." />
      </StackPanel>
    </Border>

    <!-- Part colour picker. One popup for the whole list, moved onto whichever row's swatch was clicked.
         Built here rather than with the toolkit's ColorPicker: that control's Advanced tab does not switch,
         so its colour canvas was unreachable. This uses the same canvas directly, with no tabs in the way. -->
    <!-- Opens to the LEFT of the swatch, i.e. INTO the window. The swatch sits near the right edge of the
         Parts panel, so anchoring below it pushed the panel past the window edge - and a Popup is a
         top-level window, so WPF only keeps it on the SCREEN, never inside its parent. -->
    <Popup x:Name="partColorPopup" StaysOpen="False" AllowsTransparency="True"
           Placement="Left" HorizontalOffset="-4" PopupAnimation="Fade">
      <Border Background="#C0C0C0" BorderBrush="#404040" BorderThickness="1" Padding="6">
        <StackPanel>
          <TextBlock Text="Part colour" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ItemsControl x:Name="partColorSwatches">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="2" Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{DynamicResource ColourSwatchButton}" Width="34" Height="26" Margin="2"
                        Click="OnPartColorSwatchClick" Tag="{Binding Rgb}" ToolTip="{Binding Label}">
                  <Border Width="34" Height="26" Background="{Binding Brush}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Separator Margin="0,6" />
          <xctk:ColorCanvas x:Name="partColorCanvas" UsingAlphaChannel="False" Width="230"
                            SelectedColorChanged="OnPartColorCanvasChanged" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
