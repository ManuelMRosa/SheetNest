<Window x:Class="DeepNestSharp.Ui.Views.EditPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:conv="clr-namespace:DeepNestSharp.Ui.Converters"
        xmlns:uc="clr-namespace:DeepNestSharp.Ui.UserControls"
        Title="Edit Part"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F3F3">
  <Window.Resources>
    <conv:PartPreviewConverter x:Key="PartPreview" />
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Part file -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Part file:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="partFileText" IsReadOnly="True" Background="White" Padding="4,3" MinWidth="420"
               VerticalContentAlignment="Center" />
    </DockPanel>

    <!-- Preview + Quantity (left) | Settings (right) -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <Border Width="150" Height="130" Background="White" BorderBrush="#B5B5B5" BorderThickness="1">
          <Image x:Name="previewImage" Stretch="Uniform" Margin="8" />
        </Border>

        <GroupBox Header="Quantity" Margin="0,10,0,0" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Required:" VerticalAlignment="Center" Margin="0,0,10,6" />
            <xctk:IntegerUpDown Grid.Row="0" Grid.Column="1" x:Name="requiredUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Parts needed for the job." />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Extra:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <xctk:IntegerUpDown Grid.Row="1" Grid.Column="1" x:Name="extraUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left"
                                ToolTip="Spare parts nested on top of the required quantity (e.g. in case one is scrapped)." />
          </Grid>
        </GroupBox>
      </StackPanel>

      <GroupBox Grid.Column="1" Header="Settings" Padding="8" VerticalAlignment="Stretch">
        <StackPanel MinWidth="300">
          <TextBlock Text="Orientations permitted:" Margin="0,0,0,4" />
          <uc:RotationSelector x:Name="rotationSelector" HorizontalAlignment="Stretch"
                               ToolTip="Rotations the nester may apply to THIS part (e.g. restrict for grain direction)." />

          <TextBlock Text="Priority:" Margin="0,14,0,4" />
          <ComboBox x:Name="priorityCombo" Width="150" HorizontalAlignment="Left"
                    ToolTip="Higher-priority parts are nested first — they get the best positions and are never the ones left off the sheet." />
        </StackPanel>
      </GroupBox>
    </Grid>

    <!-- OK / Cancel -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="OK" Width="84" Padding="0,4" IsDefault="True" Click="OnOk" />
      <Button Content="Cancel" Width="84" Padding="0,4" Margin="10,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
