<Window x:Class="DeepNestSharp.Ui.Views.EditPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SheetNest.Localization;assembly=SheetNest.Localization"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:conv="clr-namespace:DeepNestSharp.Ui.Converters"
        xmlns:uc="clr-namespace:DeepNestSharp.Ui.UserControls"
        Title="{x:Static loc:Strings.EditPart_Title}"
        FontFamily="Tahoma" FontSize="11"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Panel}">
  <Window.Resources>
    <conv:PartPreviewConverter x:Key="PartPreview" />
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Part file -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="{x:Static loc:Strings.EditPart_PartFile}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="partFileText" IsReadOnly="True" Background="White" Padding="4,3" MinWidth="420"
               VerticalContentAlignment="Center" />
    </DockPanel>

    <!-- Preview + Quantity (left) | Settings (right) -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <Border Width="150" Height="130" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
          <Image x:Name="previewImage" Stretch="Uniform" Margin="8" />
        </Border>

        <GroupBox Header="{x:Static loc:Strings.EditPart_Quantity}" Margin="0,10,0,0" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.EditPart_Required}" VerticalAlignment="Center" Margin="0,0,10,6" />
            <xctk:IntegerUpDown Grid.Row="0" Grid.Column="1" x:Name="requiredUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left" Margin="0,0,0,6"
                                ToolTip="{x:Static loc:Strings.EditPart_RequiredTip}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.EditPart_Extra}" VerticalAlignment="Center" Margin="0,0,10,6" />
            <xctk:IntegerUpDown Grid.Row="1" Grid.Column="1" x:Name="extraUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left" Margin="0,0,0,6"
                                ToolTip="{x:Static loc:Strings.EditPart_ExtraTip}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:Strings.EditPart_Mirrored}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <xctk:IntegerUpDown Grid.Row="2" Grid.Column="1" x:Name="mirroredUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left"
                                ToolTip="{x:Static loc:Strings.EditPart_MirroredTip}" />
          </Grid>
        </GroupBox>
      </StackPanel>

      <GroupBox Grid.Column="1" Header="{x:Static loc:Strings.EditPart_Settings}" Padding="8" VerticalAlignment="Stretch">
        <StackPanel MinWidth="300">
          <TextBlock Text="{x:Static loc:Strings.EditPart_Orientations}" Margin="0,0,0,4" />
          <uc:RotationSelector x:Name="rotationSelector" HorizontalAlignment="Stretch"
                               ToolTip="{x:Static loc:Strings.EditPart_OrientationsTip}" />
          <TextBlock x:Name="geoHint" FontSize="10" Foreground="{StaticResource Brush.Accent}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
          <TextBlock x:Name="warnHint" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Danger}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

          <TextBlock Text="{x:Static loc:Strings.EditPart_PartSpacing}" Margin="0,14,0,4" />
          <StackPanel Orientation="Horizontal">
            <xctk:DoubleUpDown x:Name="spacingUpDown" Width="90" Minimum="0" Increment="0.05" FormatString="0.###"
                               ToolTip="{x:Static loc:Strings.EditPart_PartSpacingTip}" />
            <TextBlock Text="{x:Static loc:Strings.EditPart_InDrawingUnits}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Brush.TextMuted}" />
          </StackPanel>

          <!-- A part starts safely off and becomes eligible only after the operator explicitly changes
               this selector. -->
          <StackPanel x:Name="commonCuttingGroup" Visibility="Collapsed">
            <TextBlock Text="{x:Static loc:Strings.EditPart_CommonCutting}" Margin="0,14,0,4" />
            <ComboBox x:Name="commonCuttingCombo" Width="200" HorizontalAlignment="Left"
                      ToolTip="{x:Static loc:Strings.EditPart_CommonCuttingTip}" />
            <TextBlock x:Name="commonCuttingHint" Visibility="Collapsed" Margin="0,4,0,0" FontSize="10"
                       Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" />
          </StackPanel>

          <TextBlock Text="{x:Static loc:Strings.EditPart_Priority}" Margin="0,14,0,4" />
          <ComboBox x:Name="priorityCombo" Width="150" HorizontalAlignment="Left"
                    ToolTip="{x:Static loc:Strings.EditPart_PriorityTip}" />
        </StackPanel>
      </GroupBox>
    </Grid>

    <!-- 3D unfold (only for STEP/IGES-imported parts). Changing K re-unfolds the part on OK. -->
    <GroupBox x:Name="unfold3DGroup" Grid.Row="2" Header="{x:Static loc:Strings.EditPart_Unfold3DGroup}" Margin="0,12,0,0" Padding="8" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{x:Static loc:Strings.EditPart_KFactor}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <xctk:DoubleUpDown x:Name="kFactor3DUpDown" Width="80" Minimum="0" Maximum="2" Increment="0.05" FormatString="0.###"
                           ToolTip="{x:Static loc:Strings.EditPart_KFactorTip}" />
        <TextBlock Text="{x:Static loc:Strings.EditPart_Standard}" VerticalAlignment="Center" Margin="16,0,8,0" />
        <ComboBox x:Name="std3DCombo" Width="70" SelectedIndex="0">
          <ComboBoxItem>ANSI</ComboBoxItem>
          <ComboBoxItem>DIN</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="{x:Static loc:Strings.EditPart_Thickness}" VerticalAlignment="Center" Margin="16,0,8,0" />
        <TextBlock x:Name="thickness3DText" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
      </StackPanel>
    </GroupBox>

    <!-- OK / Cancel -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="{x:Static loc:Strings.Common_OK}" Width="96" FontSize="13" Padding="0,6" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="{x:Static loc:Strings.Common_Cancel}" Width="84" Margin="10,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
