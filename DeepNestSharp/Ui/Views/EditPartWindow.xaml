<Window x:Class="DeepNestSharp.Ui.Views.EditPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:conv="clr-namespace:DeepNestSharp.Ui.Converters"
        xmlns:uc="clr-namespace:DeepNestSharp.Ui.UserControls"
        Title="Edit Part"
        FontFamily="Tahoma" FontSize="11"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Panel}">
  <Window.Resources>
    <conv:PartPreviewConverter x:Key="PartPreview" />
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Part file -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Part file:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="partFileText" IsReadOnly="True" Background="White" Padding="4,3" MinWidth="420"
               VerticalContentAlignment="Center" />
    </DockPanel>

    <!-- Preview + Quantity (left) | Settings (right) -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <Border Width="150" Height="130" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
          <Image x:Name="previewImage" Stretch="Uniform" Margin="8" />
        </Border>

        <GroupBox Header="Quantity" Margin="0,10,0,0" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Required:" VerticalAlignment="Center" Margin="0,0,10,6" />
            <xctk:IntegerUpDown Grid.Row="0" Grid.Column="1" x:Name="requiredUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Parts needed for the job." />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Extra:" VerticalAlignment="Center" Margin="0,0,10,6" />
            <xctk:IntegerUpDown Grid.Row="1" Grid.Column="1" x:Name="extraUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left" Margin="0,0,0,6"
                                ToolTip="Spare parts nested on top of the required quantity (e.g. in case one is scrapped)." />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mirrored:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <xctk:IntegerUpDown Grid.Row="2" Grid.Column="1" x:Name="mirroredUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left"
                                ToolTip="Copies nested MIRRORED (X-flipped) on top of the quantities above, for left-hand/right-hand pairs. The exported DXF cuts these mirrored." />
          </Grid>
        </GroupBox>
      </StackPanel>

      <GroupBox Grid.Column="1" Header="Settings" Padding="8" VerticalAlignment="Stretch">
        <StackPanel MinWidth="300">
          <TextBlock Text="Orientations permitted:" Margin="0,0,0,4" />
          <uc:RotationSelector x:Name="rotationSelector" HorizontalAlignment="Stretch"
                               ToolTip="Rotations the nester may apply to THIS part (e.g. restrict for grain direction)." />
          <TextBlock x:Name="geoHint" FontSize="10" Foreground="{StaticResource Brush.Accent}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
          <TextBlock x:Name="warnHint" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Danger}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

          <TextBlock Text="Part spacing:" Margin="0,14,0,4" />
          <StackPanel Orientation="Horizontal">
            <xctk:DoubleUpDown x:Name="spacingUpDown" Width="90" Minimum="0" Increment="0.05" FormatString="0.###"
                               ToolTip="Gap this part keeps to its neighbours (drawing units). Two parts end up (spacingA + spacingB) / 2 apart." />
            <TextBlock Text="in the drawing's units" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Brush.TextMuted}" />
          </StackPanel>

          <!-- Only shown for a part that came in from a SheetCam nest: that is the only way back out to
             something that knows a shared edge is cut once. Revealed in the constructor, like unfold3DGroup. -->
        <CheckBox x:Name="commonLineCheck" Content="Common line cutting" Margin="0,10,0,0" Visibility="Collapsed"
                    Checked="OnCommonLineChanged" Unchecked="OnCommonLineChanged"
                    ToolTip="Nest copies of this part TOUCHING each other (spacing 0), so shared edges are cut once. The laser program must support common-line cuts." />

          <TextBlock Text="Priority:" Margin="0,14,0,4" />
          <ComboBox x:Name="priorityCombo" Width="150" HorizontalAlignment="Left"
                    ToolTip="1 = highest priority. Higher-priority parts are nested first, so they fill the earlier sheets and are never the ones left off when material runs out." />
        </StackPanel>
      </GroupBox>
    </Grid>

    <!-- 3D unfold (only for STEP/IGES-imported parts). Changing K re-unfolds the part on OK. -->
    <GroupBox x:Name="unfold3DGroup" Grid.Row="2" Header="3D unfold (sheet metal)" Margin="0,12,0,0" Padding="8" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="K-factor:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <xctk:DoubleUpDown x:Name="kFactor3DUpDown" Width="80" Minimum="0" Maximum="2" Increment="0.05" FormatString="0.###"
                           ToolTip="Bend-allowance K-factor. Changing it re-unfolds this part with FreeCAD (the developed length changes)." />
        <TextBlock Text="Standard:" VerticalAlignment="Center" Margin="16,0,8,0" />
        <ComboBox x:Name="std3DCombo" Width="70" SelectedIndex="0">
          <ComboBoxItem>ANSI</ComboBoxItem>
          <ComboBoxItem>DIN</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Thickness:" VerticalAlignment="Center" Margin="16,0,8,0" />
        <TextBlock x:Name="thickness3DText" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
      </StackPanel>
    </GroupBox>

    <!-- OK / Cancel -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="OK" Width="96" FontSize="13" Padding="0,6" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="Cancel" Width="84" Margin="10,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
