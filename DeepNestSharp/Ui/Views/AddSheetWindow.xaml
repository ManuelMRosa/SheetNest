<Window x:Class="DeepNestSharp.Ui.Views.AddSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Custom sheet size"
        FontFamily="Tahoma" FontSize="11"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="120" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="headerText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
               Text="Sheet size in inches (width = the long side)." Foreground="{StaticResource Brush.TextMuted}" />

    <TextBlock x:Name="widthLabel" Grid.Row="1" Grid.Column="0" Text="Width (in)" VerticalAlignment="Center" Margin="0,0,10,6" />
    <xctk:IntegerUpDown x:Name="widthUpDown" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1000" Value="120" Margin="0,0,0,6" />

    <TextBlock x:Name="heightLabel" Grid.Row="2" Grid.Column="0" Text="Height (in)" VerticalAlignment="Center" Margin="0,0,10,6" />
    <xctk:IntegerUpDown x:Name="heightUpDown" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="1000" Value="60" Margin="0,0,0,6" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="Quantity" VerticalAlignment="Center" Margin="0,0,10,6" />
    <xctk:IntegerUpDown x:Name="qtyUpDown" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="10000" Value="1" Margin="0,0,0,6" />

    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="okButton" Style="{StaticResource PrimaryButton}" Content="Add" Width="88" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
