<UserControl x:Class="DeepNestSharp.Ui.UserControls.DxfViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
  <!-- Classic CAD workspace gray around the white sheet (the retro look has no dark chrome). -->
  <Grid x:Name="host" Background="#808080" ClipToBounds="True" Focusable="True"
        MouseWheel="OnMouseWheel"
        MouseLeftButtonDown="OnPanStart" MouseMove="OnPanMove" MouseLeftButtonUp="OnPanEnd"
        MouseDown="OnViewerMouseDown" MouseUp="OnViewerMouseUp"
        MouseRightButtonDown="OnResetView" PreviewKeyDown="OnViewerKeyDown">
    <!-- Canvas is drawn in sheet coordinates (Y already flipped); zoom/pan via RenderTransform.
         Anchor top-left so its origin is the host's (0,0); otherwise WPF centres a fixed-size
         Canvas and FitToView's translate would double-offset it (sheet drifts bottom-right). -->
    <Canvas x:Name="canvas" Background="Transparent"
            HorizontalAlignment="Left" VerticalAlignment="Top">
      <Canvas.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="scale" />
          <TranslateTransform x:Name="translate" />
        </TransformGroup>
      </Canvas.RenderTransform>
    </Canvas>
    <TextBlock x:Name="emptyHint"
               Text="Run a nest to see the result here."
               Foreground="#EFEFEF" FontSize="14"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
    <!-- This also carries the MEASURE readout, and pale grey text put it somewhere between hard to read on
         the #808080 workspace and invisible on the near-white sheet - which is where it lands once a nest
         fills the view. Same classic gray panel as the edit bar, so it reads over either. -->
    <Border Background="#C0C0C0" BorderBrush="#404040" BorderThickness="1" CornerRadius="0" Padding="5,2"
            IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
      <TextBlock x:Name="hintText" Text="scroll = zoom  ·  wheel-drag = pan  ·  right-click = fit"
                 Foreground="#101010" FontSize="11" />
    </Border>

    <!-- Manual nesting: select, drag and rotate parts to refine the nest by hand.
         Classic raised gray panel — square corners, no translucency (retro chrome). -->
    <Border x:Name="editBar" Background="#C0C0C0" BorderBrush="#404040" BorderThickness="1" CornerRadius="0" Padding="5,3"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="editToggle" Content="&#9995; Edit nest" Padding="8,3" FontWeight="SemiBold"
                      Checked="OnEditModeChanged" Unchecked="OnEditModeChanged"
                      ToolTip="Manual nesting: click a part to select it, drag to move, rotate with the buttons. Dragging may leave a part on top of another while you rearrange — it turns red, and the export refuses until nothing is red. Hold Alt as you drop to slide it against its neighbour instead. The arrow keys will not push a properly placed part into a neighbour, but they do move one that is already red, so you can walk it clear. Edits apply to every copy of this layout and flow into the DXF export." />
        <Button x:Name="undoBtn" Content="&#8630;" Margin="6,0,0,0" Padding="8,3" FontSize="14" IsEnabled="False"
                Click="OnUndoClick" ToolTip="Undo (Ctrl+Z)" />
        <Button x:Name="redoBtn" Content="&#8631;" Margin="3,0,0,0" Padding="8,3" FontSize="14" IsEnabled="False"
                Click="OnRedoClick" ToolTip="Redo (Ctrl+Y)" />
        <StackPanel x:Name="rotateButtons" Orientation="Horizontal" Visibility="Collapsed">
          <Button Content="&#8634; 90" Margin="6,0,0,0" Padding="6,3" Click="OnRotateCcw90" ToolTip="Rotate selected part 90° counter-clockwise" />
          <Button Content="&#8635; 90" Margin="3,0,0,0" Padding="6,3" Click="OnRotateCw90" ToolTip="Rotate selected part 90° clockwise" />
          <Button Content="&#8634; 5" Margin="6,0,0,0" Padding="6,3" Click="OnRotateCcw5" ToolTip="Rotate selected part 5° counter-clockwise" />
          <Button Content="&#8635; 5" Margin="3,0,0,0" Padding="6,3" Click="OnRotateCw5" ToolTip="Rotate selected part 5° clockwise" />
          <Button Content="&#8646; Mirror" Margin="10,0,0,0" Padding="6,3" Click="OnMirror"
                  ToolTip="Mirror the selected part (left ↔ right hand). The DXF export reflects it too, so the cut part is really mirrored — not just on screen." />
        </StackPanel>
        <!-- On a full sheet the part left on top of another can be off screen, so say so in words. -->
        <TextBlock x:Name="overlapCount" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Foreground="#B00000" Visibility="Collapsed"
                   ToolTip="Parts overlapping a neighbour or hanging off the sheet. Export refuses while any remain." />
        <ToggleButton x:Name="measureToggle" Content="Measure" Margin="12,0,0,0" Padding="8,3" FontWeight="SemiBold"
                      Checked="OnMeasureModeChanged" Unchecked="OnMeasureModeChanged"
                      ToolTip="Measure a distance: click two points on the drawing; the length shows below (in the drawing's units). Use it to verify a 3D-unfolded part's size / K-factor." />
      </StackPanel>
    </Border>

    <!-- Layout navigation, industrial style: one entry per DISTINCT layout,
         its repeat count in parentheses next to the name — "Nest 1/2 (30)" = layout 1 of 2, cut it
         30 times. Totals (utilization / sheets / placed) live in the status bar, not over the plot. -->
    <Border x:Name="sheetNav" Background="#C0C0C0" BorderBrush="#404040" BorderThickness="1" CornerRadius="0" Padding="5,3"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <Button Content="&#9664;" Width="28" Click="OnPrevSheet" ToolTip="Previous layout" />
        <TextBlock x:Name="sheetLabel" Foreground="Black" VerticalAlignment="Center"
                   Margin="10,0" MinWidth="80" TextAlignment="Center" FontWeight="Bold" />
        <Button Content="&#9654;" Width="28" Click="OnNextSheet" ToolTip="Next layout" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
