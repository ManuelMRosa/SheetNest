<UserControl x:Class="DeepNestSharp.Ui.UserControls.DxfViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SheetNest.Localization;assembly=SheetNest.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
  <!-- Classic CAD workspace gray around the white sheet (the retro look has no dark chrome). -->
  <Grid x:Name="host" Background="#808080" ClipToBounds="True" Focusable="True"
        MouseWheel="OnMouseWheel"
        MouseLeftButtonDown="OnPanStart" MouseMove="OnPanMove" MouseLeftButtonUp="OnPanEnd"
        MouseDown="OnViewerMouseDown" MouseUp="OnViewerMouseUp"
        MouseRightButtonDown="OnResetView" PreviewKeyDown="OnViewerKeyDown">
    <!-- Canvas is drawn in sheet coordinates (Y already flipped); zoom/pan via RenderTransform.
         Anchor top-left so its origin is the host's (0,0); otherwise WPF centres a fixed-size
         Canvas and FitToView's translate would double-offset it (sheet drifts bottom-right). -->
    <Canvas x:Name="canvas" Background="Transparent"
            HorizontalAlignment="Left" VerticalAlignment="Top">
      <Canvas.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="scale" />
          <TranslateTransform x:Name="translate" />
        </TransformGroup>
      </Canvas.RenderTransform>
    </Canvas>
    <TextBlock x:Name="emptyHint"
               Text="{x:Static loc:Strings.Viewer_EmptyHint}"
               Foreground="#EFEFEF" FontSize="14"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
    <!-- This also carries the MEASURE readout, and pale grey text put it somewhere between hard to read on
         the #808080 workspace and invisible on the near-white sheet - which is where it lands once a nest
         fills the view. Same classic gray panel as the edit bar, so it reads over either. -->
    <Border Background="#C0C0C0" BorderBrush="#404040" BorderThickness="1" CornerRadius="0" Padding="5,2"
            IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
      <TextBlock x:Name="hintText" Text="{x:Static loc:Strings.Viewer_HintView}"
                 Foreground="#101010" FontSize="11" />
    </Border>

    <!-- Manual nesting: select, drag and rotate parts to refine the nest by hand.
         Classic raised gray panel — square corners, no translucency (retro chrome). -->
    <Border x:Name="editBar" Background="#C0C0C0" BorderBrush="#404040" BorderThickness="1" CornerRadius="0" Padding="5,3"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="editToggle" Content="{x:Static loc:Strings.Viewer_EditNest}" Padding="8,3" FontWeight="SemiBold"
                      Checked="OnEditModeChanged" Unchecked="OnEditModeChanged"
                      ToolTip="{x:Static loc:Strings.Viewer_EditNestTip}" />
        <Button x:Name="undoBtn" Content="&#8630;" Margin="6,0,0,0" Padding="8,3" FontSize="14" IsEnabled="False"
                Click="OnUndoClick" ToolTip="{x:Static loc:Strings.Viewer_UndoTip}" />
        <Button x:Name="redoBtn" Content="&#8631;" Margin="3,0,0,0" Padding="8,3" FontSize="14" IsEnabled="False"
                Click="OnRedoClick" ToolTip="{x:Static loc:Strings.Viewer_RedoTip}" />
        <StackPanel x:Name="rotateButtons" Orientation="Horizontal" Visibility="Collapsed">
          <Button Content="&#8634; 90" Margin="6,0,0,0" Padding="6,3" Click="OnRotateCcw90" ToolTip="{x:Static loc:Strings.Viewer_RotateCcw90Tip}" />
          <Button Content="&#8635; 90" Margin="3,0,0,0" Padding="6,3" Click="OnRotateCw90" ToolTip="{x:Static loc:Strings.Viewer_RotateCw90Tip}" />
          <Button Content="&#8634; 5" Margin="6,0,0,0" Padding="6,3" Click="OnRotateCcw5" ToolTip="{x:Static loc:Strings.Viewer_RotateCcw5Tip}" />
          <Button Content="&#8635; 5" Margin="3,0,0,0" Padding="6,3" Click="OnRotateCw5" ToolTip="{x:Static loc:Strings.Viewer_RotateCw5Tip}" />
          <Button Content="{x:Static loc:Strings.Viewer_Mirror}" Margin="10,0,0,0" Padding="6,3" Click="OnMirror"
                  ToolTip="{x:Static loc:Strings.Viewer_MirrorTip}" />
        </StackPanel>
        <!-- On a full sheet the part left on top of another can be off screen, so say so in words. -->
        <TextBlock x:Name="overlapCount" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Foreground="#B00000" Visibility="Collapsed"
                   ToolTip="{x:Static loc:Strings.Viewer_OverlapCountTip}" />
        <ToggleButton x:Name="measureToggle" Content="{x:Static loc:Strings.Viewer_Measure}" Margin="12,0,0,0" Padding="8,3" FontWeight="SemiBold"
                      Checked="OnMeasureModeChanged" Unchecked="OnMeasureModeChanged"
                      ToolTip="{x:Static loc:Strings.Viewer_MeasureTip}" />
      </StackPanel>
    </Border>

    <!-- The selected part, and the only place its numbers can be typed rather than dragged to. Dragging is
         imprecise and hard over a distance, so anything reachable only by dragging needs a way in from the
         keyboard. X and Y are the part's BOTTOM-LEFT CORNER on the sheet, which is what can be measured on
         the real plate; the placement's own offset is an internal datum and means nothing to an operator.
         Bottom-left is the one free corner: the edit bar is top-left, the hints bottom-right, the layout
         nav bottom-centre. -->
    <Border x:Name="partInfo" Background="#C0C0C0" BorderBrush="#404040" BorderThickness="1" CornerRadius="0" Padding="5,3"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="partInfoName" Foreground="#101010" FontSize="11" FontWeight="SemiBold"
                   VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="X" Foreground="#101010" FontSize="11" VerticalAlignment="Center" Margin="10,0,3,0" />
        <TextBox x:Name="partX" Width="62" FontSize="11" VerticalAlignment="Center"
                 KeyDown="OnPartFieldKey" LostKeyboardFocus="OnPartFieldCommit"
                 GotKeyboardFocus="OnPartFieldFocus" PreviewMouseLeftButtonDown="OnPartFieldClick"
                 ToolTip="{x:Static loc:Strings.Viewer_PartXTip}" />
        <TextBlock Text="Y" Foreground="#101010" FontSize="11" VerticalAlignment="Center" Margin="8,0,3,0" />
        <TextBox x:Name="partY" Width="62" FontSize="11" VerticalAlignment="Center"
                 KeyDown="OnPartFieldKey" LostKeyboardFocus="OnPartFieldCommit"
                 GotKeyboardFocus="OnPartFieldFocus" PreviewMouseLeftButtonDown="OnPartFieldClick"
                 ToolTip="{x:Static loc:Strings.Viewer_PartYTip}" />
        <TextBlock Text="&#8735;" Foreground="#101010" FontSize="13" VerticalAlignment="Center" Margin="8,0,3,0" />
        <TextBox x:Name="partAngle" Width="46" FontSize="11" VerticalAlignment="Center"
                 KeyDown="OnPartFieldKey" LostKeyboardFocus="OnPartFieldCommit"
                 GotKeyboardFocus="OnPartFieldFocus" PreviewMouseLeftButtonDown="OnPartFieldClick"
                 ToolTip="{x:Static loc:Strings.Viewer_PartAngleTip}" />
        <!-- Measured when the part comes to rest, not on every mouse move: the exact distance between two
             outlines is a search, and a drag asks hundreds of questions per second already. -->
        <TextBlock x:Name="partGap" Foreground="#101010" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                   ToolTip="{x:Static loc:Strings.Viewer_PartGapTip}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
