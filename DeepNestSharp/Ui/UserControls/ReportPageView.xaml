<UserControl x:Class="DeepNestSharp.Ui.UserControls.ReportPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Nest report's page, handled like the nest viewer: the wheel zooms toward the cursor, the wheel held down pans,
       a right-click fits the page back. The same grey workspace and the same hint in the corner. -->
  <Grid x:Name="host" Background="#808080" ClipToBounds="True" Focusable="True"
        MouseWheel="OnMouseWheel" MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp"
        MouseRightButtonDown="OnResetView">
    <!-- Anchored top-left, like the viewer's canvas, so the transform works from the host's own corner. -->
    <!-- Sized in code from the report's own page size, so the two cannot drift apart. -->
    <Image x:Name="page" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Image.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="scale" />
          <TranslateTransform x:Name="translate" />
        </TransformGroup>
      </Image.RenderTransform>
    </Image>
    <Border Background="#C0C0C0" BorderBrush="#404040" BorderThickness="1" CornerRadius="0" Padding="5,2"
            IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
      <TextBlock Text="scroll = zoom  ·  wheel-drag = pan  ·  right-click = fit" Foreground="#101010" FontSize="11" />
    </Border>
  </Grid>
</UserControl>
