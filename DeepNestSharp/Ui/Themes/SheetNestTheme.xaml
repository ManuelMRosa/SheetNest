<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══ SheetNest light theme ═══
       EVERY style here is KEYED — never add an implicit (TargetType-only) style: it would leak into
       Xceed up/down templates, the Add Sheet ContextMenu, GridView headers and RotationSelector. -->

  <!-- Accent (SheetNest green) -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#2E7D32" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#388E3C" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1B5E20" />
  <SolidColorBrush x:Key="Brush.AccentTint" Color="#E8F5E9" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#C62828" />
  <SolidColorBrush x:Key="Brush.DangerHover" Color="#D32F2F" />
  <SolidColorBrush x:Key="Brush.DangerPressed" Color="#B71C1C" />

  <!-- Surfaces -->
  <SolidColorBrush x:Key="Brush.Window" Color="#FAFAFA" />
  <SolidColorBrush x:Key="Brush.Panel" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Brush.StatusBar" Color="#ECECEC" />
  <SolidColorBrush x:Key="Brush.Card" Color="White" />
  <SolidColorBrush x:Key="Brush.Hover" Color="#EDEDED" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="#E0E0E0" />

  <!-- Borders -->
  <SolidColorBrush x:Key="Brush.Border" Color="#DDDDDD" />
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#EEEEEE" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CCCCCC" />

  <!-- Text -->
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1F1F1F" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#555555" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#888888" />

  <!-- Flat modern button: white face, subtle border, rounded corners, clear hover/pressed. -->
  <Style x:Key="ModernButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="4" BorderThickness="1"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The primary action (NEST / dialog OK): solid accent green. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="22,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="4" BorderThickness="0"
                  Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The destructive counterpart of PrimaryButton (Clear Result): solid red, same shape. -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="4" BorderThickness="0"
                  Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.DangerHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.DangerPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Square icon button (✎ / ✕): quiet until hovered, generous hit target. -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
  </Style>

  <!-- Thin vertical divider between toolbar groups. -->
  <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Fill" Value="{StaticResource Brush.Border}" />
    <Setter Property="Margin" Value="8,6" />
  </Style>

  <!-- Small muted caption/hint text. -->
  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>

  <!-- Settings/status text styles (moved from MainWindow.Resources — same keys, brushed colors). -->
  <Style x:Key="SettingLabel" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,6,10,6" />
  </Style>

  <Style x:Key="StatusValue" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="4,0,16,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="StatusLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="12,0,2,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
