<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══ SheetNest retro theme — Windows Classic 95/2000 ═══
       The authentic control chrome comes from the PresentationFramework.Classic dictionary merged in
       App.xaml; this file only supplies the palette (battleship gray, navy values, NO greens) and
       the app's keyed styles. EVERY style here is KEYED — never add an implicit (TargetType-only)
       style: it would leak into Xceed up/down templates, the Add Sheet ContextMenu, GridView headers
       and RotationSelector. -->

  <!-- Accent: classic navy (values/selection), maroon for danger tints. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#000080" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#1A1A9C" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#000060" />
  <SolidColorBrush x:Key="Brush.AccentTint" Color="#D6D6E8" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#800000" />
  <SolidColorBrush x:Key="Brush.DangerHover" Color="#9C1A1A" />
  <SolidColorBrush x:Key="Brush.DangerPressed" Color="#600000" />

  <!-- Surfaces: classic ButtonFace gray everywhere; white only for list/data areas. -->
  <SolidColorBrush x:Key="Brush.Window" Color="#C0C0C0" />
  <SolidColorBrush x:Key="Brush.Panel" Color="#C0C0C0" />
  <SolidColorBrush x:Key="Brush.StatusBar" Color="#C0C0C0" />
  <SolidColorBrush x:Key="Brush.Card" Color="White" />
  <SolidColorBrush x:Key="Brush.Hover" Color="#C0C0C0" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="#A0A0A0" />

  <!-- Borders: the classic shadow/highlight grays. -->
  <SolidColorBrush x:Key="Brush.Border" Color="#808080" />
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#D4D0C8" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#404040" />

  <!-- Text: classic UIs used near-black text, not light grays. -->
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#000000" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#333333" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#555555" />

  <!-- Toolbar/dialog button: NO custom template — the merged Classic dictionary provides the real
       3D-beveled chrome. Only spacing/size here. -->
  <Style x:Key="ModernButton" TargetType="Button">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The primary action (NEST / dialog OK): classic gray like everything else, just bold. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="18,4" />
  </Style>

  <!-- Clear Result: same classic button (bold text), no red — retro look has no colored buttons. -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />

  <!-- Square icon button (✎ / ✕): small classic button. -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Thin vertical divider between toolbar groups. -->
  <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Fill" Value="{StaticResource Brush.Border}" />
    <Setter Property="Margin" Value="8,4" />
  </Style>

  <!-- Small muted caption/hint text. -->
  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>

  <!-- "Available 31/31" cell: classic SUNKEN white field with navy bold value (the pill is gone —
       nothing rounded in this theme). -->
  <Style x:Key="CountBadge" TargetType="Border">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CountBadgeText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Settings/status text styles (moved from MainWindow.Resources — same keys, brushed colors). -->
  <Style x:Key="SettingLabel" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,6,10,6" />
  </Style>

  <Style x:Key="StatusValue" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="4,0,16,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="StatusLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="12,0,2,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
